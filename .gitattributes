* text=auto
# Preserve runnable shell scripts across Windows/cloud checkouts.
*.sh text eol=lf
# Windows desktop launcher; source is stored canonically as LF in Git.
/OYUNU_AC.cmd text eol=crlf
/ORTAK_SKILLLERI_KUR.cmd text eol=crlf
# Runtime manifests hash exact bytes; use the same content bytes on every OS.
game/data/content/*.json text eol=lf
# A sealed release is byte-addressed by FILE_INDEX.json. Never normalize it.
release/current/** -text whitespace=-blank-at-eol,-blank-at-eof
# Archived provenance hashes must survive Windows and cloud checkouts exactly.
.agents/archive/** -text whitespace=-blank-at-eol,-blank-at-eof
# Shared source pins are byte-addressed; Windows must not normalize them.
.agents/library/upstream/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
references/shared_godot/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
game/assets/third_party/reference/** -text whitespace=-blank-at-eol,-blank-at-eof
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.gltf binary
*.pck binary
# Signed bytes: never normalize line endings (the signature covers the exact bytes).
*.sig binary
game/tests/fixtures/content_manifest/* binary

# Keep redistributed upstream font license bytes, including their trailing whitespace.
game/assets/fonts/art_direction_v01/*-OFL.txt -text whitespace=-blank-at-eol

# BATCH-0005: preserve audited Legacy source bytes, including original line endings.
# Covers the reorganized canon, scripts, references and production-note folders too.
narrative/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/canon/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/story/*.md -text whitespace=-blank-at-eol,-blank-at-eof
narrative/lore/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/content/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/tools/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/art/*.md -text whitespace=-blank-at-eol,-blank-at-eof
narrative/art/*.json -text whitespace=-blank-at-eol,-blank-at-eof
narrative/prompts/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/audio/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/archive/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/docs/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/design/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/migration/sources/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/migration/audits/** -text whitespace=-blank-at-eol,-blank-at-eof
narrative/CHANGELOG_NARRATIVE.md -text whitespace=-blank-at-eol,-blank-at-eof
release/current/artifacts/game.aab filter=lfs diff=lfs merge=lfs -text
release/current/artifacts/opening-base.pck filter=lfs diff=lfs merge=lfs -text
