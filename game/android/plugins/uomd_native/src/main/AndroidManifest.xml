<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- androidx.credentials declares these for passkey/biometric flows; Google sign-in does not use them (INF-018 allowlist). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <application>
        <!-- Godot Android plugin v2: the engine instantiates this class and registers it as the singleton "UomdNative". -->
        <meta-data
            android:name="org.godotengine.plugin.v2.UomdNative"
            android:value="io.github.mucaeksi.uomd.UomdNative" />
        <!-- AdMob app id (INF-036): written by tools/build_uomd_native.sh from ADMOB_APP_ID (owner decision D-18); until
             then Google's published sample app id, which serves only test ads. The SDK stops the app without one. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/uomd_admob_app_id" />
    </application>
</manifest>
