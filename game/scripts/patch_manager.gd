extends Node
var server_base_url="http://127.0.0.1:8080"
func check_and_apply():
 var r=HTTPRequest.new();add_child(r);var e=r.request(server_base_url+"/v1/content/manifest");if e!=OK:r.queue_free();return {"ok":false,"error":"manifest request failed"};var c=await r.request_completed;r.queue_free();if c[1]<200 or c[1]>=300:return {"ok":false,"error":"manifest http "+str(c[1])};var m=JSON.parse_string((c[3] as PackedByteArray).get_string_from_utf8());if typeof(m)!=TYPE_DICTIONARY:return {"ok":false,"error":"invalid manifest"};var local="0.0.0";if FileAccess.file_exists("user://content_version.txt"):local=FileAccess.get_file_as_string("user://content_version.txt").strip_edges();for p in m.get("patches",[]):if str(p.version)>local:var x=await download_patch(p);if not x.ok:return x;local=str(p.version);FileAccess.store_string("user://content_version.txt",local);return {"ok":true,"version":local}
func download_patch(p):
 var r=HTTPRequest.new();add_child(r);var e=r.request(str(p.url));if e!=OK:r.queue_free();return {"ok":false,"error":"patch request failed"};var c=await r.request_completed;r.queue_free();if c[1]<200 or c[1]>=300:return {"ok":false,"error":"patch http "+str(c[1])};var f="user://patches/"+str(p.file);DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("user://patches"));var w=FileAccess.open(f,FileAccess.WRITE);if w==null:return {"ok":false,"error":"cannot write"};w.store_buffer(c[3]);w.close();if str(p.sha256)!="" and FileAccess.get_sha256(f).to_lower()!=str(p.sha256).to_lower():return {"ok":false,"error":"sha mismatch"};if not ProjectSettings.load_resource_pack(f,true):return {"ok":false,"error":"pck load failed"};return {"ok":true}
