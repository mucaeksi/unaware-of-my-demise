    {
      "op": "say",
      "line_id": "ac_ch03_entry_003",
      "speaker": "ac_mera_holt",
      "speaker_display": "Mera",
      "text": "A new route was stamped over the old one. This ink is ordinary. Someone chose it.",
      "emotion": "focused"
    },
    {
      "op": "say",
      "line_id": "ac_ch03_entry_004",
      "speaker": "ac_tovin_reed",
      "speaker_display": "Tovin",
      "text": "I was told the south bridge could not take another load.",
      "emotion": "guarded"
    },
    {
      "op": "say",
      "line_id": "ac_ch03_entry_005",
      "speaker": "jori_flint",
      "speaker_display": "Jori",
      "text": "Did you see the bridge?",
      "emotion": "stern"
    },
    {
      "op": "say",
      "line_id": "ac_ch03_entry_006",
      "speaker": "ac_tovin_reed",
      "speaker_display": "Tovin",
      "text": "No.",
      "emotion": "quiet"
    },
    {
      "op": "say",
      "line_id": "ac_ch03_entry_007",
      "speaker": "ac_mera_holt",
      "speaker_display": "Mera",
      "text": "We will read the instruction we have, not invent the one we want.",
      "emotion": "firm"
    },
