    {
      "op": "say",
      "line_id": "tw_a5_end_002",
      "speaker": "clem_marr",
      "speaker_display": "Clem",
      "text": "And keep the village account. I would like to read it again if I come this way.",
      "emotion": "bright"
    },
    {
      "op": "say",
      "line_id": "tw_a5_end_003",
      "speaker": "tw_lantern_carrier",
      "speaker_display": "Lantern Carrier",
      "text": "It has room for another visit.",
      "emotion": "warm"
    },
    {
      "op": "hide",
      "character": "clem_marr"
    },
    {
      "op": "show",
      "character": "thistle_roe",
      "side": "left"
