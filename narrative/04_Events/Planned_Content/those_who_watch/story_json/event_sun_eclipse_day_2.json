      "speaker": "thistle_roe",
      "speaker_display": "Thistle",
      "text": "The owing-bells are all opening. All of them. The whole ridge.",
      "emotion": "frightened"
    },
    {
      "op": "show",
      "character": "vespera_wisp",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "event_sun_eclipse_day_2_002",
      "speaker": "vespera_wisp",
      "speaker_display": "Vespera",
      "text": "It is not breathing. It is recounting. Every owed hour in the valley, checked at once.",
      "emotion": "grave"
    },
    {
      "op": "say",
      "line_id": "event_sun_eclipse_day_2_003",
      "speaker": "thistle_roe",
      "speaker_display": "Thistle",
      "text": "Why t-today?",
      "emotion": "tense"
    },
    {
      "op": "say",
      "line_id": "event_sun_eclipse_day_2_004",
      "speaker": "vespera_wisp",
      "speaker_display": "Vespera",
      "text": "Because someone set a day for it. Machines keep calendars. So do chancellors.",
      "emotion": "quiet"
    },
