{
  "source_sha256": "68c39d3be767b32404ad5de1ee3dc537196d6e989f48a1d8aabeaadf3020b693",
  "event": {
    "event_id": "event_sun_eclipse_day",
    "title_en": "The Day the Eclipse Breathes",
    "event_type": "mystery",
    "canon_status": "canon",
    "timeline_placement": "after stage 6-5",
    "unlock": {
      "after_stage": "6-5"
    },
    "purpose_en": "A folk holy day when the eclipse is said to move. Foreshadows the altar, the cult and the Law of Hours.",
    "featured_character_ids": [
      "vespera_wisp",
      "thistle_roe",
      "clem_marr"
    ],
    "scenes": [
      {
        "scene_id": "event_sun_eclipse_day_1",
        "title_en": "An Old Holy Day",
        "location_id": "eastern_highland_road",
        "direction_en": "On their own safe route to the altar, Clem, Vespera and Thistle join highland villagers climbing to watch the far mountain where the eclipse hangs.",
        "lines": [
          {
            "line_id": "event_sun_eclipse_day_1_001",
            "speaker_id": "clem_marr",
            "speaker_display": "Clem",
            "text_en": "Sun-Eclipse Day. Once a year the villages say the black sun breathes.",
            "emotion": "curious",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_1_002",
            "speaker_id": "vespera_wisp",
            "speaker_display": "Vespera",
            "text_en": "Does it?",
            "emotion": "dry",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_1_003",
            "speaker_id": "clem_marr",
            "speaker_display": "Clem",
            "text_en": "Every grave-keeper's record says yes. Every scholar's says no. I trust grave-keepers.",
            "emotion": "cheerful",
            "voice_track": "jp"
          }
        ]
      },
      {
        "scene_id": "event_sun_eclipse_day_2",
        "title_en": "The Breath",
        "location_id": "highland_ridge",
        "direction_en": "At noon the eclipse's rim flickers. Every bell pin, charm and bell in the valley hums at once.",
        "lines": [
          {
            "line_id": "event_sun_eclipse_day_2_001",
            "speaker_id": "thistle_roe",
            "speaker_display": "Thistle",
            "text_en": "The owing-bells are all opening. All of them. The whole ridge.",
            "emotion": "frightened",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_2_002",
            "speaker_id": "vespera_wisp",
            "speaker_display": "Vespera",
            "text_en": "It is not breathing. It is recounting. Every owed hour in the valley, checked at once.",
            "emotion": "grave",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_2_003",
            "speaker_id": "thistle_roe",
            "speaker_display": "Thistle",
            "text_en": "Why t-today?",
            "emotion": "tense",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_2_004",
            "speaker_id": "vespera_wisp",
            "speaker_display": "Vespera",
            "text_en": "Because someone set a day for it. Machines keep calendars. So do chancellors.",
            "emotion": "quiet",
            "voice_track": "jp"
          }
        ]
      },
      {
        "scene_id": "event_sun_eclipse_day_3",
        "title_en": "Tokens",
        "location_id": "highland_village",
        "direction_en": "The villagers give each traveler a stamped token so the eclipse will \"know they watched\".",
        "lines": [
          {
            "line_id": "event_sun_eclipse_day_3_001",
            "speaker_id": "clem_marr",
            "speaker_display": "Clem",
            "text_en": "Sun-Eclipse tokens. Superstition. I am keeping five.",
            "emotion": "delighted",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_3_002",
            "speaker_id": "thistle_roe",
            "speaker_display": "Thistle",
            "text_en": "Why five?",
            "emotion": "curious",
            "voice_track": "jp"
          },
          {
            "line_id": "event_sun_eclipse_day_3_003",
            "speaker_id": "clem_marr",
            "speaker_display": "Clem",
            "text_en": "One for each of us who watched. So somebody knows we were here.",
            "emotion": "gentle",
            "voice_track": "jp"
          }
        ]
      }
    ]
  }
}
