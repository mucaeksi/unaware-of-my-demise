    {
      "op": "say",
      "line_id": "tl_a4_last_lane_007",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "We have crossed two roads and kept every stopper in place.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "tilda_fen",
