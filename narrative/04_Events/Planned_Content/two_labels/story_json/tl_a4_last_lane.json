    },
    {
      "op": "say",
      "line_id": "tl_a4_last_lane_008",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "That was the easy part. One more clear passage.",
      "emotion": "dry"
    },
