    {
      "op": "hide",
      "character": "tilda_fen"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_004",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "Yes. They meet before the harbor.",
      "emotion": "calm"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "iona_mist",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_005",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "Then we are choosing how to arrive. Not who gets medicine.",
      "emotion": "gentle"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_006",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "A mercifully sensible map.",
      "emotion": "wry"
