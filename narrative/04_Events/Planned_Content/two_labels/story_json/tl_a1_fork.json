    {
      "op": "say",
      "line_id": "tl_a1_fork_001",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "The coast path bends below the watch posts. You can see far. So can anything waiting there.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_002",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "The load road has shelter, but no room to step aside. We will need to keep the front steady.",
      "emotion": "focused"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_003",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "Both reach the villages?",
      "emotion": "focused"
