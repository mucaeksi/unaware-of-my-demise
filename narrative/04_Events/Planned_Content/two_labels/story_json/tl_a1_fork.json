    {
      "op": "show",
      "character": "kera_voss",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_010",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "If the water has a complaint, it may submit it in writing.",
