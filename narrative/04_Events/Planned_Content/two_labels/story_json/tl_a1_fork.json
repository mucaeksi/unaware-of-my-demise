    {
      "op": "hide",
      "character": "iona_mist"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_007",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "It is not the map that will carry the crates.",
      "emotion": "quiet"
    },
    {
      "op": "hide",
      "character": "kera_voss"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "choice",
      "prompt": "Choose the delivery route.",
      "options": [
        {
          "id": "tl_route_coast",
          "text": "Take the coast path — rear-line threats.",
          "goto": "coast"
        },
        {
          "id": "tl_route_load",
          "text": "Take the old load road — sustained front-line pressure.",
          "goto": "load"
        }
      ]
