      "op": "say",
      "line_id": "tl_a1_fork_011",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "I will keep the cloth over the glass.",
      "emotion": "gentle"
    },
    {
      "op": "hide",
      "character": "kera_voss"
    },
    {
      "op": "hide",
      "character": "iona_mist"
    },
    {
      "op": "goto",
      "label": "choice_join"
    },
    {
      "op": "label",
      "name": "load"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_012",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "Stay close enough to pass the kit. Far enough that one fallen crate does not stop all of us.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "tilda_fen"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a1_fork_013",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "I will check the shed doors before we reach them.",
      "emotion": "focused"
