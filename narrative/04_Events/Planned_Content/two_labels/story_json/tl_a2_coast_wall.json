      "character": "kera_voss",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "tl_a2_coast_wall_003",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "They are looking at the crates.",
      "emotion": "focused"
