    {
      "op": "say",
      "line_id": "tl_a5_end_004",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "We can leave both.",
      "emotion": "gentle"
    },
    {
      "op": "say",
      "line_id": "tl_a5_end_005",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "It will be a very large notice.",
      "emotion": "wry"
    },
    {
      "op": "narrate",
      "line_id": "tl_a5_end_006",
      "text": "The crates knock gently as they walk. Paper labels remain tied to their handles."
    },
    {
      "op": "hide",
      "character": "iona_mist"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a5_end_007",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "Do we take those off?",
      "emotion": "quiet"
    },
    {
      "op": "say",
      "line_id": "tl_a5_end_008",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "No. They still say who brought them.",
      "emotion": "quiet"
    },
    {
      "op": "narrate",
      "line_id": "tl_a5_end_009",
      "text": "Nothing about the road has become easy. It is only easier to know whom to ask."
    },
