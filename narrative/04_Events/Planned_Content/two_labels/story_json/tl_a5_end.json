    {
      "op": "say",
      "line_id": "tl_a5_end_002",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "The next notice needs a place for questions.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a5_end_003",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "And a place for whoever answers them to sit down.",
      "emotion": "dry"
