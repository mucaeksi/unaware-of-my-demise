{
  "schema_version": 1,
  "scene_id": "tl_a4_echo_listen",
  "title_en": "What They Asked",
  "location_id": "tl_clinic_table",
  "commands": [
    {
      "op": "background",
      "location_id": "tl_clinic_table"
    },
    {
      "op": "music",
      "cue_id": "tl_work"
    },
    {
      "op": "fade",
      "direction": "in",
      "seconds": 0.35
    },
    {
      "op": "say",
      "line_id": "tl_a4_echo_listen_001",
      "speaker": "tl_patient",
      "speaker_display": "Patient",
      "text": "Someone at the shelter asked me what you wanted in return. I knew what to say.",
      "emotion": "quiet"
    },
    {
      "op": "show",
      "character": "iona_mist",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a4_echo_listen_002",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "And if they have another question, they can come here.",
      "emotion": "gentle"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "tl_a4_echo_listen_003",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "Or write it. We have room left on the paper.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "iona_mist"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a4_echo_listen_004",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "She checked. Twice.",
      "emotion": "dry"
    },
    {
      "op": "hide",
      "character": "tilda_fen"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a4_echo_listen_005",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "They brought the bench closer so they could hear.",
      "emotion": "small_smile"
    },
    {
      "op": "narrate",
      "line_id": "tl_a4_echo_listen_006",
      "text": "On the table, the question has left a small crease in the paper. Kera does not flatten it away."
    },
    {
      "op": "checkpoint",
      "checkpoint_id": "tl_a4_echo_listen_done"
    },
    {
      "op": "end"
    }
  ],
