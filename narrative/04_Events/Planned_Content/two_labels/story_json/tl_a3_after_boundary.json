      "op": "narrate",
      "line_id": "tl_a3_after_boundary_001",
      "text": "The lantern returns to its hook. The people inside have not moved from the dry benches."
    },
    {
      "op": "say",
      "line_id": "tl_a3_after_boundary_002",
      "speaker": "tl_patient",
      "speaker_display": "Patient",
      "text": "Did we make you stay longer?",
      "emotion": "worried"
