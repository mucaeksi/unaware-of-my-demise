    {
      "op": "say",
      "line_id": "tl_a3_bakery_001",
      "speaker": "tl_baker",
      "speaker_display": "Baker",
      "text": "You can use the side room. The table is clean enough for bread. I do not know about medicine.",
      "emotion": "guarded"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_002",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "Then we clean it once more. Thank you.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "tilda_fen"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_003",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "We will not need the ovens.",
      "emotion": "hesitant"
