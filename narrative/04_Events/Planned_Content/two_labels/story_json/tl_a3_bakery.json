    {
      "op": "say",
      "line_id": "tl_a3_bakery_004",
      "speaker": "tl_baker",
      "speaker_display": "Baker",
      "text": "Good. They are occupied.",
      "emotion": "dry"
    },
    {
      "op": "narrate",
      "line_id": "tl_a3_bakery_005",
      "text": "The baker notices Odelia's cap, then looks back at the crates. Recognition is left unspoken."
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_006",
      "speaker": "tl_baker",
      "speaker_display": "Baker",
      "text": "A free bottle usually comes with a second question.",
      "emotion": "guarded"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_007",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "Mine comes with instructions.",
      "emotion": "focused"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_008",
      "speaker": "tl_baker",
      "speaker_display": "Baker",
      "text": "And after the instructions?",
      "emotion": "serious"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "iona_mist",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_009",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "You may ask us something. You do not owe us an answer.",
      "emotion": "gentle"
    },
    {
      "op": "hide",
      "character": "iona_mist"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "tl_a3_bakery_010",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "Nobody is giving a blood sample, signing a debt, or promising a favor for this treatment.",
      "emotion": "focused"
