  "scenes": [
    {
      "scene_id": "or_a1_after",
      "act": 1,
      "title_en": "Beyond the Crossing",
      "location_id": "or_relief_stop",
      "direction_en": "Nara and Marek are on the safe side with survivors. The bridge and Oren are off-screen; no fate is assigned to either.",
      "purpose_tr": "5-5 yan sivil rota; Mahmut/Fadyme geri dönmez.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a1_after_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Beyond the crossing, a stretch of firm ground has become a place to stop. It needs to become a place other people can use.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "or_a1_after_002",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Keep the exit wide. Resting people should not become a wall for arriving people.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_after_003",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "The volunteers have brought water and cloth. They need to know where each belongs.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_after_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "We can keep it going if someone shows us the order.",
          "emotion": "hesitant",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_after_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Then we will show you. After that, you will show us.",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_after_006",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "She accepts demonstrations more readily than thanks.",
          "emotion": "wry",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "or_a1_need",
      "act": 1,
      "title_en": "A Stop with Two Edges",
      "location_id": "or_relief_stop",
      "direction_en": "Supplies and the passage are both necessary. No survivor is assigned a hidden death outcome.",
      "purpose_tr": "Yardım düzeninin devri; Refugee Measure şarkısı tekrar değil.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a1_need_001",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "If we put everything close to the bench, the next group can reach it.",
          "emotion": "worried",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_need_002",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "And if the boxes close the approach, they cannot reach the bench.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_need_003",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "We need an order that works when the two of us have gone ahead.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_need_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "I thought keeping you here was the safer plan.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_need_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "A useful place should not depend on one pair of shoulders.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_need_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Marek sets his spear beside the supply board. He does not start a marching song.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a1_handoff",
      "act": 1,
      "title_en": "Show the Next Hands",
      "location_id": "or_relief_stop",
      "direction_en": "Choose which operational task to teach first. Both are completed before the handover.",
      "purpose_tr": "Handoff sırası iki farklı rehearsal ve battle düzeni.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a1_handoff_001",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "We can start with finding and replacing supplies, or with keeping the way through open.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_handoff_002",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "The first needs a steady entrance. The second needs the reaching threat noticed early.",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a1_handoff_003",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Tell me what to try. I will do it, rather than promise I understood.",
          "emotion": "focused",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Begin the handover.",
        "state_key": "handoff",
        "options": [
          {
            "id": "or_handoff_supply",
            "value": "supply",
            "text_en": "Teach the supply handover first.",
            "consequence_en": "Show stock placement and replacement; battle emphasizes a steady front.",
            "lines": [
              {
                "line_id": "or_a1_handoff_004",
                "speaker_id": "marek_vane",
                "speaker_display": "Marek",
                "text_en": "Find a cloth, bring it to the bench, then show where the next one waits.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "or_a1_handoff_005",
                "speaker_id": "nara_vell",
                "speaker_display": "Nara",
                "text_en": "I will watch the approach while you learn the order.",
                "emotion": "calm",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "or_handoff_passage",
            "value": "passage",
            "text_en": "Teach the open passage first.",
            "consequence_en": "Show waiting and passing space; battle emphasizes the reaching threat.",
            "lines": [
              {
                "line_id": "or_a1_handoff_006",
                "speaker_id": "nara_vell",
                "speaker_display": "Nara",
                "text_en": "Walk it as if you had never seen this stop. Tell us where you must hesitate.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "or_a1_handoff_007",
                "speaker_id": "marek_vane",
                "speaker_display": "Marek",
                "text_en": "I will carry the empty basket through after you.",
                "emotion": "calm",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "or_a2_supply_1",
      "act": 2,
      "title_en": "Where the Next Cloth Waits",
      "location_id": "or_supply_board",
      "direction_en": "The volunteer demonstrates a simple stock handover. Supplies are story props, not reward inventory.",
      "purpose_tr": "Görünür stok işleyişi; yapı/üretim ekonomisi eklenmez.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a2_supply_1_001",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "One here, one brought forward, the empty cloth marker laid flat.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_1_002",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "Good. How does the next person see that the stack is low?",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_1_003",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "I could call for you.",
          "emotion": "hesitant",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_1_004",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "Try a person who will still be here.",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_1_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "The keeper at the bench can see a flat marker. Put it where their eyes already go.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_1_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The volunteer moves the marker, then starts the handover again.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a2_supply_2",
      "act": 2,
      "title_en": "An Order Someone Else Can Use",
      "location_id": "or_supply_board",
      "direction_en": "The route through is also cleared. The volunteer can repeat the procedure without Marek doing it for them.",
      "purpose_tr": "Supply dalı tamam; herikiiş de biter.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a2_supply_2_001",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "Now pretend I am sitting at the bench. What do you need from me?",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_2_002",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Leave the opening clear. Put the used cloth here, so the clean stack stays clean.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_2_003",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "That is an instruction people can follow.",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_2_004",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "And one I can follow while sitting down. A rare luxury.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_supply_2_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The exit remains open. The board holds enough room for another pair of hands.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a2_passage_1",
      "act": 2,
      "title_en": "Walk It Once",
      "location_id": "or_waiting_lane",
      "direction_en": "Nara asks the volunteer to walk the passage at an ordinary pace. No real-time civilian pathfinding is required.",
      "purpose_tr": "İşaret/tabela tamiri değil işlevsel mekân düzeni ve rehearsal.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a2_passage_1_001",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Here I would stop. I cannot see whether that space is for waiting or passing.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_1_002",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Then separate the bench from the opening. Do not make the tired person guess.",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_1_003",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "The supply basket can wait inside the marked space.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_1_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "That leaves the turn open.",
          "emotion": "relieved",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_1_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Try it again from the other side. Nobody arriving owes us knowledge of the first side.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_1_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The volunteer returns by the same clear opening, without taking the shortest line across the bench.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a2_passage_2",
      "act": 2,
      "title_en": "Leave the Opening",
      "location_id": "or_waiting_lane",
      "direction_en": "The supplies are made accessible too. Marek gives a small practical instruction rather than a procession song.",
      "purpose_tr": "Passage dalı tamam; yeni kalıcı buildsystem yok.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a2_passage_2_001",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "Water within reach of someone seated. Extra cloth behind it, where it stays dry.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_2_002",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "And nobody waits inside the opening, even when the bench is full.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_2_003",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "What do you do when it is full?",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_2_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Ask the next group to stop on the firm ground here. I do not press them against the exit.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_2_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Good. That is a place, not a crowd.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a2_passage_2_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Marek puts the empty basket down where its owner can find it again.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a3_line",
      "act": 3,
      "title_en": "The Remaining Threat",
      "location_id": "or_safe_approach",
      "direction_en": "Known bridge dead approach the outer ground. Survivors and volunteers remain safely behind the relief point.",
      "purpose_tr": "B01 standard battle; sivil escortAI yok.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a3_line_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "A dead guard drags its weapon over the far stones. Others follow where the firm ground narrows.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "or_a3_line_002",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "Everyone behind the stop. This is the line we keep, not a line you join.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_line_003",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "Read the one supporting the formation. The nearest blade is not the only threat.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_line_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Do we move the people again?",
          "emotion": "worried",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_line_005",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "They have safe room. Keep it clear for them.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_line_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The two step forward without asking the volunteers to hold a weapon.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "or_a3_safe",
      "act": 3,
      "title_en": "Use It Again",
      "location_id": "or_relief_stop",
      "direction_en": "After standard victory, the handover demonstration resumes without repeating the battle.",
      "purpose_tr": "Savaş sonrası işlevsel kontrol; kast yaralanma kaybı cezaları yok.",
      "music_cue": "or_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "or_a3_safe_001",
          "speaker_id": "marek_vane",
          "speaker_display": "Marek",
          "text_en": "The approach is clear. Show us the order once more.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_safe_002",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "Waiting space here. Passing space there. Supplies brought forward without blocking either.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_safe_003",
          "speaker_id": "nara_vell",
          "speaker_display": "Nara",
          "text_en": "And who can explain it if you are resting?",
          "emotion": "measured",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_safe_004",
          "speaker_id": "or_volunteer",
          "speaker_display": "Volunteer",
          "text_en": "The next volunteer. I will show them before I sit down.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "or_a3_safe_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Marek leaves the supply board in the volunteer’s hands.",
          "emotion": "composed",
