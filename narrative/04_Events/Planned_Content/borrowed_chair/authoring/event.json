  "scenes": [
    {
      "scene_id": "bc_a1_stack",
      "act": 1,
      "title_en": "One of the Returning Chairs",
      "location_id": "oakhaven_square",
      "direction_en": "A vignette inside the existing supper-ending chair-return montage. This is not the repaired chair left in the square or an additional next day.",
      "purpose_tr": "Existing od_a5_end montage içi; original repairedchair kalır.",
      "music_cue": "bc_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "bc_a1_stack_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Among the chairs going home, one has a strip of red cloth tied beneath the seat. Jori checks the knot before lifting it.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "bc_a1_stack_002",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "This one belongs to the house with the low door.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_stack_003",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "I remember the owner. She brought the sharp little onions.",
          "emotion": "bright",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_stack_004",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "You remember everybody by the sound or the food.",
          "emotion": "dry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_stack_005",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "Very reliable methods of finding people at supper.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_stack_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The repaired chair stays in the square, where the innkeeper said it could stay.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "bc_a1_stack_007",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "Take the other side. The door is lower than the chair is wide.",
          "emotion": "calm",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "bc_a1_walk",
      "act": 1,
      "title_en": "Carrying without a Chorus",
      "location_id": "bc_house_door",
      "direction_en": "Jori and Pippa carry a different borrowed chair to a nearby door. No carrying minigame or additional travel day.",
      "purpose_tr": "Kısa emanet yolculuğu; show rehearse değil.",
      "music_cue": "bc_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "bc_a1_walk_001",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "I could make a verse of the return journey.",
          "emotion": "bright",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_walk_002",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "It is twelve steps.",
          "emotion": "dry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_walk_003",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "A short verse.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_walk_004",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "Keep your hand under the seat. That will be more useful.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a1_walk_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Pippa adjusts her grip. They reach the door without an audience following them.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "bc_a1_walk_006",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "Useful can be quiet. I am practicing.",
          "emotion": "quiet",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "bc_a2_door",
      "act": 2,
      "title_en": "The Door and the Chair",
      "location_id": "bc_house_door",
      "direction_en": "The owner receives the borrowed chair. Choose who leads the brief thanks; no confession or festival song is requested.",
      "purpose_tr": "Tek ilişkisel tercih; battle veya affection score yok.",
      "music_cue": "bc_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "bc_a2_door_001",
          "speaker_id": "bc_householder",
          "speaker_display": "Householder",
          "text_en": "There it is. I thought you might decide it belonged to the square now.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a2_door_002",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "It belonged to the square for supper. It belongs here again.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a2_door_003",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "It had a very good evening.",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a2_door_004",
          "speaker_id": "bc_householder",
          "speaker_display": "Householder",
          "text_en": "It is a chair. I had the evening.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a2_door_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Jori turns the seat to pass the threshold without scraping it.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ],
      "choice": {
        "prompt_en": "Who leads the short thank-you?",
        "state_key": "voice",
        "options": [
          {
            "id": "bc_voice_jori",
            "value": "jori",
            "text_en": "Let Jori speak about the borrowed work.",
            "consequence_en": "A practical thanks; the owner tells how she used the chair before supper.",
            "lines": [
              {
                "line_id": "bc_a2_door_006",
                "speaker_id": "jori_flint",
                "speaker_display": "Jori",
                "text_en": "The brace held. Thank you for lending something you use.",
                "emotion": "quiet",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_007",
                "speaker_id": "bc_householder",
                "speaker_display": "Householder",
                "text_en": "I sit here when I peel onions. Tonight somebody else got the seat.",
                "emotion": "warm",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_008",
                "speaker_id": "jori_flint",
                "speaker_display": "Jori",
                "text_en": "Then we brought it back before the next bowl of onions.",
                "emotion": "calm",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_009",
                "speaker_id": "pippa_bell",
                "speaker_display": "Pippa",
                "text_en": "A considerate timetable.",
                "emotion": "wry",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "bc_voice_pippa",
            "value": "pippa",
            "text_en": "Let Pippa share a small supper memory.",
            "consequence_en": "A brief remembered moment; the owner chooses what she keeps from it.",
            "lines": [
              {
                "line_id": "bc_a2_door_010",
                "speaker_id": "pippa_bell",
                "speaker_display": "Pippa",
                "text_en": "I saw you laugh before the last verse. Jori was defending the soup from criticism.",
                "emotion": "gentle",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_011",
                "speaker_id": "jori_flint",
                "speaker_display": "Jori",
                "text_en": "I was criticizing the soup.",
                "emotion": "dry",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_012",
                "speaker_id": "bc_householder",
                "speaker_display": "Householder",
                "text_en": "Yes. That was the part I liked.",
                "emotion": "amused",
                "voice_track": "jp"
              },
              {
                "line_id": "bc_a2_door_013",
                "speaker_id": "pippa_bell",
                "speaker_display": "Pippa",
                "text_en": "Then that is a very good part to keep.",
                "emotion": "small_smile",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "bc_a3_inside",
      "act": 3,
      "title_en": "Where the Seat Usually Stands",
      "location_id": "bc_house_door",
      "direction_en": "The owner puts the chair in its normal place. The company stays at the doorway.",
      "purpose_tr": "Homeview küçükinsanî sonuç; nextfestivalpromise actualschedule değil.",
      "music_cue": "bc_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "bc_a3_inside_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The chair returns to the patch of floor beside the low window. The owner rests one hand on its back.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "bc_a3_inside_002",
          "speaker_id": "bc_householder",
          "speaker_display": "Householder",
          "text_en": "The square sounded different with everybody sitting close.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_inside_003",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "Will you lend it again?",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_inside_004",
          "speaker_id": "bc_householder",
          "speaker_display": "Householder",
          "text_en": "Ask when there is another supper. I might bring onions again.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_inside_005",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "We will remember the door.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_inside_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The red cloth stays tied beneath the seat. It catches the light from the low window.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "bc_a3_end",
      "act": 3,
      "title_en": "Twelve Steps Back",
      "location_id": "oakhaven_square",
      "direction_en": "The scene returns to the existing ending montage, not a new festival or extra day.",
      "purpose_tr": "Montagegenişletme ortakfinal. Pippacharm/Jorichains reveal yok.",
      "music_cue": "bc_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "bc_a3_end_001",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "She kept a different part of the evening than I did.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_end_002",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "She was sitting somewhere else.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_end_003",
          "speaker_id": "pippa_bell",
          "speaker_display": "Pippa",
          "text_en": "That is annoyingly sensible.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_end_004",
          "speaker_id": "jori_flint",
          "speaker_display": "Jori",
          "text_en": "Keep your hands free. There are bowls to bring inside.",
          "emotion": "dry",
          "voice_track": "jp"
        },
        {
          "line_id": "bc_a3_end_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "They return to the square while the last dishes are being stacked. The chair is already home.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    }
  ],
