    {
      "op": "narrate",
      "line_id": "od_a1_square_001",
      "text": "The square has been loud with orders for days. Now the loudest order is where to put a chair."
    },
    {
      "op": "show",
      "character": "jori_flint",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_002",
      "speaker": "jori_flint",
      "speaker_display": "Jori",
      "text": "Not there. The leg will catch in the drain.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "jori_flint"
    },
    {
      "op": "show",
      "character": "nixie_vale",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_003",
      "speaker": "nixie_vale",
      "speaker_display": "Nixie",
      "text": "Then we put the short people at that end. They will not notice.",
      "emotion": "bright"
    },
    {
      "op": "hide",
      "character": "nixie_vale"
    },
    {
      "op": "show",
      "character": "jori_flint",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_004",
      "speaker": "jori_flint",
      "speaker_display": "Jori",
      "text": "They will notice falling over.",
      "emotion": "annoyed"
    },
    {
      "op": "show",
      "character": "pippa_bell",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_005",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "A table that applauds when you sit down. Very festive.",
      "emotion": "bright"
    },
    {
      "op": "hide",
      "character": "jori_flint"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_006",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "I have brought a contribution.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "kera_voss"
    },
    {
      "op": "show",
      "character": "jori_flint",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_007",
      "speaker": "jori_flint",
      "speaker_display": "Jori",
      "text": "Is it meant to be making that noise?",
      "emotion": "serious"
    },
    {
      "op": "hide",
      "character": "jori_flint"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_008",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "That is a cooking noise.",
      "emotion": "defensive"
    },
    {
      "op": "say",
      "line_id": "od_a1_square_009",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "We will discover what it is called when it reaches a bowl.",
      "emotion": "wry"
    },
    {
      "op": "narrate",
      "line_id": "od_a1_square_010",
      "text": "A helper carries a stack of bowls past them. Everyone steps aside at a different speed."
    },
    {
      "op": "say",
      "line_id": "od_a1_square_011",
      "speaker": "oakhaven_innkeeper",
      "speaker_display": "Innkeeper",
      "text": "If you have a free hand, there is work for it. If you have two, I will be delighted.",
      "emotion": "warm"
    },
