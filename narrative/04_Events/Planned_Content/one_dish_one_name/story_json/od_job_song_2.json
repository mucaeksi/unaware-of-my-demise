      "op": "say",
      "line_id": "od_job_song_2_001",
      "speaker": "od_guest",
      "speaker_display": "Guest",
      "text": "I can give you a name. I would rather not give you the story.",
      "emotion": "hesitant"
    },
    {
      "op": "show",
      "character": "pippa_bell",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "od_job_song_2_002",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "I asked for one line. I did not ask for every page.",
      "emotion": "gentle"
    },
    {
      "op": "show",
      "character": "jori_flint",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_job_song_2_003",
      "speaker": "jori_flint",
      "speaker_display": "Jori",
      "text": "We can keep a seat where you do not have to face the square.",
      "emotion": "calm"
    },
    {
      "op": "say",
      "line_id": "od_job_song_2_004",
      "speaker": "od_guest",
      "speaker_display": "Guest",
      "text": "I might join the song. Later.",
      "emotion": "quiet"
    },
    {
      "op": "say",
      "line_id": "od_job_song_2_005",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "Then later is a perfectly good time for it.",
      "emotion": "gentle"
    },
    {
      "op": "narrate",
      "line_id": "od_job_song_2_006",
      "text": "Pippa rehearses the syllables softly enough that only the guest can correct them."
    },
    {
      "op": "hide",
      "character": "jori_flint"
    },
    {
      "op": "show",
      "character": "nixie_vale",
      "side": "right"
