{
  "schema_version": 1,
  "scene_id": "od_job_song_1",
  "title_en": "A Name That Fits",
  "location_id": "od_song_corner",
  "commands": [
    {
      "op": "background",
      "location_id": "od_song_corner"
    },
    {
      "op": "music",
      "cue_id": "od_work"
    },
    {
      "op": "fade",
      "direction": "in",
      "seconds": 0.35
    },
    {
      "op": "show",
      "character": "pippa_bell",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_001",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "Short names, long names, names that need a second breath. There is room.",
      "emotion": "bright"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_002",
      "speaker": "od_guest",
      "speaker_display": "Guest",
      "text": "Mine will spoil the rhythm.",
      "emotion": "hesitant"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_003",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "Then the rhythm can improve itself.",
      "emotion": "gentle"
    },
    {
      "op": "show",
      "character": "nixie_vale",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_004",
      "speaker": "nixie_vale",
      "speaker_display": "Nixie",
      "text": "A sensible rhythm. We should invite it more often.",
      "emotion": "bright"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_005",
      "speaker": "od_guest",
      "speaker_display": "Guest",
      "text": "Could I bring my mother's name instead?",
      "emotion": "quiet"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_006",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "If that is the name you wish us to sing.",
      "emotion": "gentle"
    },
    {
      "op": "narrate",
      "line_id": "od_job_song_1_007",
      "text": "Pippa leaves a space before writing. The guest says it once, then again slowly."
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_008",
      "speaker": "pippa_bell",
      "speaker_display": "Pippa",
      "text": "Like that?",
      "emotion": "focused"
    },
    {
      "op": "say",
      "line_id": "od_job_song_1_009",
      "speaker": "od_guest",
      "speaker_display": "Guest",
      "text": "Like that.",
      "emotion": "relieved"
    },
    {
      "op": "checkpoint",
      "checkpoint_id": "od_job_song_1_done"
    },
    {
      "op": "end"
    }
  ],
