  "scenes": [
    {
      "scene_id": "dr_a1_edge",
      "act": 1,
      "title_en": "The Damp Edge",
      "location_id": "dr_refuge_desk",
      "direction_en": "Ordinary linen-loan slips rest on a table in the refuge. The royal register and the font page remain elsewhere.",
      "purpose_tr": "Sıradan emanet kaydı ve ona ihtiyaç duyan insan; royal record keşfi değil.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a1_edge_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Water has reached the edge of the linen book. A dark line climbs the page without asking where the writing ends.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a1_edge_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Lift the cover. Not the wet corner.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_edge_003",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "And leave the passage clear. Someone is coming through with a blanket.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_edge_004",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I was told my slip would show where to return it.",
          "emotion": "hesitant",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_edge_005",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "It should. A book that cannot be used is merely heavy paper.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_edge_006",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Sit on this side while we make it useful again.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_edge_007",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Mirel lays an empty board beneath the book. Aveline moves the chair without moving the person out of reach.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "dr_a1_slip",
      "act": 1,
      "title_en": "Two Places on One Line",
      "location_id": "dr_refuge_desk",
      "direction_en": "A linen-return slip has a legible day and a blurred receiving-place entry. No personal name is erased.",
      "purpose_tr": "Belirsizliği gizlemeyen kayıt okuma; isim geri yazma veya borç geciktirme yok.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a1_slip_001",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The day is clear. The receiving place is not.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_slip_002",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I borrowed it before the rain. I do not want to put it where nobody finds it.",
          "emotion": "worried",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_slip_003",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Nobody will send you back into the rain for an unclear line.",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_slip_004",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Nor will we improve the line by guessing confidently.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_slip_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The original slip remains beside the book. Mirel writes its page number on a dry scrap.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a1_slip_006",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "There is a dry side room, and a sound table beside this wall. Which can we make ready first?",
          "emotion": "focused",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a1_layout",
      "act": 1,
      "title_en": "A Place to Use the Book",
      "location_id": "dr_refuge_desk",
      "direction_en": "Choose a working layout. Both keep the person warm and the original slip intact.",
      "purpose_tr": "Layout iki sabit encounter düzeni ve iki mekân sahnesini seçer.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a1_layout_001",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The shelf gives us space to sort the pages. We must keep the route to it clear.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_layout_002",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "The wall table lets people come to the record. We must hold this entrance steady.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a1_layout_003",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The book has no preference. Its readers do.",
          "emotion": "wry",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Prepare the working place.",
        "state_key": "layout",
        "options": [
          {
            "id": "dr_layout_shelf",
            "value": "shelf",
            "text_en": "Move the records to the dry side room.",
            "consequence_en": "Clear a supported threat from the approach; the person waits inside.",
            "lines": [
              {
                "line_id": "dr_a1_layout_004",
                "speaker_id": "mirel_quill",
                "speaker_display": "Mirel",
                "text_en": "Page numbers outward. Then we can find the line without turning everything over.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a1_layout_005",
                "speaker_id": "sister_aveline",
                "speaker_display": "Aveline",
                "text_en": "I will keep the waiting place beside the door.",
                "emotion": "calm",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "dr_layout_desk",
            "value": "desk",
            "text_en": "Prepare the sheltered wall table.",
            "consequence_en": "Hold the entrance against front pressure; the records stay within reach.",
            "lines": [
              {
                "line_id": "dr_a1_layout_006",
                "speaker_id": "sister_aveline",
                "speaker_display": "Aveline",
                "text_en": "Keep the opening wide enough for two people to pass.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a1_layout_007",
                "speaker_id": "mirel_quill",
                "speaker_display": "Mirel",
                "text_en": "I will make the slips face the reader, rather than the wall.",
                "emotion": "precise",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "dr_a2_shelf_1",
      "act": 2,
      "title_en": "Page Numbers Outward",
      "location_id": "dr_dry_room",
      "direction_en": "Mirel moves ordinary slips in their existing order; the cathedral archive as a whole remains damaged.",
      "purpose_tr": "Shelf dalı 1; düzen ile kişiye erişim birlikte.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_shelf_1_001",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "This stack stays in order. A dry mistake is still a mistake.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_1_002",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "I have brought a cloth for the bench, not the book.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_1_003",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Thank you. The book is not the only thing waiting here.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_1_004",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The carrier settles close enough to see the slips being moved.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a2_shelf_1_005",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I can recognize mine from here.",
          "emotion": "relieved",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_1_006",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Good. Recognition is useful evidence. We will keep it beside the page number.",
          "emotion": "precise",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a2_shelf_2",
      "act": 2,
      "title_en": "Room beside the Shelf",
      "location_id": "dr_dry_room",
      "direction_en": "Aveline checks the access path. No candle-count scene is repeated.",
      "purpose_tr": "Shelf dalı 2; ana arşiv kraliyet sayfası kurutulmaz.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_shelf_2_001",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "This crate goes behind the bench. Nobody should have to step over it to reach the shelf.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_2_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "An excellent shelving rule. I wish more scribes had feet.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_2_003",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I could hold the stack.",
          "emotion": "hesitant",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_2_004",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Hold the dry board instead. You need not risk the slip twice.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_shelf_2_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The pages settle on the shelf with their numbers visible. The carrier keeps the original on the board.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a2_shelf_2_006",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Now we can look without making you stand in the doorway.",
          "emotion": "warm",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a2_desk_1",
      "act": 2,
      "title_en": "The Wall Table",
      "location_id": "dr_refuge_desk",
      "direction_en": "Aveline clears space around a solid table. Mirel keeps the original and any new note separate.",
      "purpose_tr": "Desk dalı 1; kayıt confidence teması.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_desk_1_001",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "This side for waiting. That side for anyone walking through.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_1_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The original goes here. New notes go on the clean board.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_1_003",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "Why not write the clearer answer on the slip?",
          "emotion": "curious",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_1_004",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Because we have not earned a clearer answer yet.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_1_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Aveline shifts the lamp. The blurred line remains blurred, but can be seen without leaning into the passage.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a2_desk_1_006",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "At least nobody has to read in the dark while we ask.",
          "emotion": "gentle",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a2_desk_2",
      "act": 2,
      "title_en": "A Reader at the Table",
      "location_id": "dr_refuge_desk",
      "direction_en": "The table is accessible to someone sitting down. No repair or carrying minigame is implied.",
      "purpose_tr": "Desk dalı 2; sosyal sessizliğe davet değil birlikte belge inceleme.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_desk_2_001",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I thought the table was for the people keeping the book.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_2_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "It is for the book being read.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_2_003",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Which includes you.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_2_004",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Mirel turns the board toward the carrier. Aveline rests a dry blanket across the chair back.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a2_desk_2_005",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "You can point to what you remember. We will not make the page say it first.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_desk_2_006",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I remember the blue cord around the bundle.",
          "emotion": "relieved",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a2_reading",
      "act": 2,
      "title_en": "A Note Is Not an Answer",
      "location_id": "dr_refuge_desk",
      "direction_en": "The readable date and blue-cord detail are visible. Choose how to document the unclear receiving place.",
      "purpose_tr": "Kayıt okuma yöntemi iki farklı somut resolution; battle düzenini değiştirmez.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_reading_001",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The slip tells us the day. The blue cord may tell us which return point lent it.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_reading_002",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "We can record the limit of what we know, or ask the keeper of the bundles.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_reading_003",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Either is honest. Only one pretends the water never touched the line, and we will not do that.",
          "emotion": "precise",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Handle the unclear entry.",
        "state_key": "reading",
        "options": [
          {
            "id": "dr_reading_note",
            "value": "note",
            "text_en": "Attach a note: receiving place unclear.",
            "consequence_en": "Preserve the original and route the return through the refuge keeper.",
            "lines": [
              {
                "line_id": "dr_a2_reading_004",
                "speaker_id": "mirel_quill",
                "speaker_display": "Mirel",
                "text_en": "A separate note. Clear date, unclear place, blue cord remembered by the carrier.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a2_reading_005",
                "speaker_id": "sister_aveline",
                "speaker_display": "Aveline",
                "text_en": "The refuge keeper can receive it safely without inventing a destination.",
                "emotion": "calm",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a2_reading_006",
                "speaker_id": "dr_carrier",
                "speaker_display": "Carrier",
                "text_en": "Then I can return it here and let them check.",
                "emotion": "relieved",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "dr_reading_ask",
            "value": "ask",
            "text_en": "Ask the linen keeper about the blue cord.",
            "consequence_en": "Confirm the ordinary return point while keeping the original unchanged.",
            "lines": [
              {
                "line_id": "dr_a2_reading_007",
                "speaker_id": "sister_aveline",
                "speaker_display": "Aveline",
                "text_en": "I will ask from the door. Stay warm while we check.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a2_reading_008",
                "speaker_id": "mirel_quill",
                "speaker_display": "Mirel",
                "text_en": "A confirmed answer belongs on a new note, with where it came from.",
                "emotion": "precise",
                "voice_track": "jp"
              },
              {
                "line_id": "dr_a2_reading_009",
                "speaker_id": "dr_carrier",
                "speaker_display": "Carrier",
                "text_en": "I can show the cord. It is still on the bundle.",
                "emotion": "quiet",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "dr_a2_note",
      "act": 2,
      "title_en": "The Limit Written Down",
      "location_id": "dr_refuge_desk",
      "direction_en": "Mirel attaches a plain note to the original. It is an ordinary administrative action, not witness magic.",
      "purpose_tr": "Note dalı: doğru belirsizlik kaydı.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_note_001",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "There. The note says what was legible and what was not.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_note_002",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "Is an unclear place allowed in the book?",
          "emotion": "hesitant",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_note_003",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "It was already there. Now it is admitted.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_note_004",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "And you have a place to leave the bundle while it is checked.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_note_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The carrier places the slip flat on the board instead of trying to unfold the wet corner again.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "dr_a2_ask",
      "act": 2,
      "title_en": "The Cord and the Keeper",
      "location_id": "dr_refuge_desk",
      "direction_en": "The linen keeper confirms off-screen that blue-cord bundles return at the refuge desk. No named historical witness enters.",
      "purpose_tr": "Ask dalı: canlı kaynak doğrulaması; kayıp royal isim bulunmaz.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a2_ask_001",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Blue cords return here. The keeper tied them herself before the rain.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_ask_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "Then I will note that she confirmed it. I will not mend the original handwriting into ours.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_ask_003",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "I thought I had forgotten the way.",
          "emotion": "relieved",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_ask_004",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "The line got wet. You did not do anything wrong.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a2_ask_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The cord lies beside the note, an ordinary small thing that helped an answer become clear.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "dr_a3_passage",
      "act": 3,
      "title_en": "Before the Next Person",
      "location_id": "dr_refuge_passage",
      "direction_en": "Known cathedral dead block the outer approach. Everyone seeking the desk remains behind a safe doorway.",
      "purpose_tr": "Standard B01; desk/shelf prepared profile. No destructible ledger HP.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a3_passage_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "A scrape travels along the outer passage. Aveline sets the carrier’s board safely inside.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a3_passage_002",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Keep this doorway clear. Nobody waiting here comes into the fight.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_passage_003",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "One behind the armor is sustaining the line. Look before choosing the target.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_passage_004",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "We have room to hold. We have a reason to keep it.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_passage_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The book remains on dry wood. The two women face the approach, not the waiting bench.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "dr_a3_clear",
      "act": 3,
      "title_en": "A Passage for Readers",
      "location_id": "dr_refuge_passage",
      "direction_en": "After standard victory, waiting people can use the safe approach.",
      "purpose_tr": "Zafer iki yöntemde aynı güvenli sonuca gider.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a3_clear_001",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Clear. Bring the board when you are ready.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_clear_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The slips are still in order.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_clear_003",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "And I know where to bring the bundle.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_clear_004",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "Good. Let someone else carry it through the door with you.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a3_clear_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The next reader comes inside without balancing over a crate.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
      "scene_id": "dr_a4_found",
      "act": 4,
      "title_en": "The Right Page",
      "location_id": "dr_refuge_desk",
      "direction_en": "The return is recorded using the selected note policy. The private royal record is not on this table.",
      "purpose_tr": "Gündelik kayıt işlevsel sonuç; miktar/envanter ödülü yok.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a4_found_001",
          "speaker_id": "dr_carrier",
          "speaker_display": "Carrier",
          "text_en": "This is the page. I can see the day now.",
          "emotion": "relieved",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_found_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "The day was clear before. We have made it easier to find.",
          "emotion": "precise",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_found_003",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "And easier to use without standing in the wet.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_found_004",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The bundle rests beside the return desk. Its final receiving entry is left to the keeper who accepts it.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "dr_a4_found_005",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "We can leave an honest place for the next line.",
          "emotion": "quiet",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "dr_a4_end",
      "act": 4,
      "title_en": "Two Dry Places",
      "location_id": "dr_refuge_desk",
      "direction_en": "The women return to the established cathedral work. The flooded nave and main-story damaged page remain unchanged.",
      "purpose_tr": "Ortak bitiş; 2-4/2-5 keşifleri yerinde.",
      "music_cue": "dr_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "dr_a4_end_001",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "The record has somewhere to wait. So do the people.",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_end_002",
          "speaker_id": "mirel_quill",
          "speaker_display": "Mirel",
          "text_en": "I may borrow that wording for the shelf rules.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_end_003",
          "speaker_id": "sister_aveline",
          "speaker_display": "Aveline",
          "text_en": "You may. Keep the shelf within reach.",
          "emotion": "warm",
          "voice_track": "jp"
        },
        {
          "line_id": "dr_a4_end_004",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Mirel sets a dry board beneath the next slip. Aveline opens space for the next reader.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    }
