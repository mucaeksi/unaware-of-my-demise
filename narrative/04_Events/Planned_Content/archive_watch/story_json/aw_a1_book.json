      "line_id": "aw_a1_book_005",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "Both. A diagram is less convincing when nobody can use it.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "tilda_fen"
    },
    {
      "op": "show",
      "character": "iona_mist",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "aw_a1_book_006",
      "speaker": "iona_mist",
      "speaker_display": "Iona",
      "text": "Then we keep the case separate from the people who lived it.",
      "emotion": "gentle"
    },
    {
      "op": "narrate",
      "line_id": "aw_a1_book_007",
      "text": "The book stays in the archive. The exercise opens as a reconstruction, not as another journey in their day."
