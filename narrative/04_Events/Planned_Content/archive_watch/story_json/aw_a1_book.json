      "op": "narrate",
      "line_id": "aw_a1_book_001",
      "text": "Kera opens a casebook on a clear table. Three diagrams show roads already known, and threats already met."
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "aw_a1_book_002",
      "speaker": "kera_voss",
      "speaker_display": "Kera",
      "text": "Three cases. No new alarm. No patients needed for demonstration.",
      "emotion": "focused"
    },
    {
      "op": "show",
      "character": "tilda_fen",
      "side": "left"
    },
    {
      "op": "say",
      "line_id": "aw_a1_book_003",
      "speaker": "tilda_fen",
      "speaker_display": "Tilda",
      "text": "An excellent beginning for a training plan.",
      "emotion": "dry"
    },
    {
      "op": "hide",
      "character": "kera_voss"
    },
    {
      "op": "show",
      "character": "odelia_pike",
      "side": "right"
    },
    {
      "op": "say",
      "line_id": "aw_a1_book_004",
      "speaker": "odelia_pike",
      "speaker_display": "Odelia",
      "text": "Are we reading or trying another way through?",
      "emotion": "calm"
    },
    {
      "op": "hide",
      "character": "odelia_pike"
    },
    {
      "op": "show",
      "character": "kera_voss",
      "side": "right"
