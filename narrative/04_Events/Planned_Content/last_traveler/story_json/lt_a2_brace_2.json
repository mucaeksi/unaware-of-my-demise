    {
      "op": "say",
      "line_id": "lt_a2_brace_2_002",
      "speaker": "nixie_vale",
      "speaker_display": "Nixie",
      "text": "If we use the bank, I can watch farther across. If we use the beam, I can watch the near gap.",
      "emotion": "focused"
    },
    {
      "op": "hide",
      "character": "nixie_vale"
    },
    {
      "op": "show",
