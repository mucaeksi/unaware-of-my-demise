          "text_en": "Both keep the road open. Choose the line you want to hold.",
          "emotion": "calm",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Choose the defensive footing.",
        "state_key": "plan",
        "options": [
          {
