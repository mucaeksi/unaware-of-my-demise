          "line_id": "lt_a4_traveler_009",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "The traveler tests the footing, then walks through without needing to hurry.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        }
      ]
    },
    {
