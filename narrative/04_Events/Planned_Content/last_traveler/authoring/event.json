  "scenes": [
    {
      "scene_id": "lt_a1_sign",
      "act": 1,
      "title_en": "The Fallen Sign",
      "location_id": "lt_forest_junction",
      "direction_en": "A small route sign lies face-down beside the forest path. No carved personal name is being restored, and no royal clue is visible.",
      "purpose_tr": "1-4 sonrası kısa yol aralığı; ana false-map olayını çözmez, silinen isim/kraliyet kaydı bulunmaz.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a1_sign_001",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "At the bend beyond the shrine, the sign is lying where nobody can read it without leaving the road.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "lt_a1_sign_002",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "That is an unhelpful place for a helpful thing.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_003",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "The post is loose. I can stand it up again.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_004",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "Wait. We should see why it fell.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_005",
          "speaker_id": "fadyme",
          "speaker_display": "Fadyme",
          "text_en": "A sign that tells us to step off the path deserves a little suspicion.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_006",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "There are tracks behind it. Not all of them came from the road.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_007",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "Something is moving at the far bend.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_sign_008",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Brin turns the sign face-up without pushing it into the earth.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "lt_a1_sign_009",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "We clear the passage before anyone follows it.",
          "emotion": "calm",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "lt_a1_load",
      "act": 1,
      "title_en": "Not All on One Shoulder",
      "location_id": "lt_forest_junction",
      "direction_en": "Brin tests the post with her shoulder while Nixie studies the lane. The others stand within sight rather than leaving them on a new expedition.",
      "purpose_tr": "Paylaşılan emek; Brin’in büyük companion dönüm noktasını veya babasının olayını yeniden anlatmaz.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a1_load_001",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "The footing is soft here.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_002",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "I can find where it stops being soft.",
          "emotion": "bright",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_003",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "I can keep it steady while you look.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_004",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "Set it down until we have chosen the place. You do not need to hold it for us to talk.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_005",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "Brin lowers the post. Nothing important falls with it.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "lt_a1_load_006",
          "speaker_id": "fadyme",
          "speaker_display": "Fadyme",
          "text_en": "A useful beginning.",
          "emotion": "gentle",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_007",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "I was afraid the plan would involve all of us leaning against it until evening.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_load_008",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "That would be a bad plan.",
          "emotion": "quiet",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "lt_a1_method",
      "act": 1,
      "title_en": "Read the Road or Brace It",
      "location_id": "lt_forest_junction",
      "direction_en": "Two approaches are offered with visible tactical previews. They are methods, not a choice between saving one group and abandoning another.",
      "purpose_tr": "İki ana yaklaşım. Yöntem alt seçimi farklı hazır encounter profiline bağlanır.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a1_method_001",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "I can read the turn first. Find what is coming and where it can reach.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_method_002",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "Or we brace the narrow side. Give the people behind us a clear place to wait.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_method_003",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "Either can work. Tell us what you need from the rest of us.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a1_method_004",
          "speaker_id": "fadyme",
          "speaker_display": "Fadyme",
          "text_en": "Preferably before we all volunteer for the same end of a post.",
          "emotion": "wry",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Choose the first approach.",
        "state_key": "method",
        "options": [
          {
            "id": "lt_method_scout",
            "value": "scout",
            "text_en": "Read the turn — identify the reaching threat.",
            "consequence_en": "Nixie leads. Inspect tracks or listen at the bend; rear threats are visible before battle.",
            "lines": [
              {
                "line_id": "lt_a1_method_005",
                "speaker_id": "nixie_vale",
                "speaker_display": "Nixie",
                "text_en": "Stay where you can see the sign. I will not go beyond the first tree.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a1_method_006",
                "speaker_id": "brin_alder",
                "speaker_display": "Brin",
                "text_en": "I will watch the space behind you.",
                "emotion": "calm",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a1_method_007",
                "speaker_id": "mahmut",
                "speaker_display": "Mahmut",
                "text_en": "Call before you need us to move.",
                "emotion": "calm",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "lt_method_brace",
            "value": "brace",
            "text_en": "Brace the passage — steady the front line.",
            "consequence_en": "Brin leads. Choose the bank or beam footing; front pressure is visible before battle.",
            "lines": [
              {
                "line_id": "lt_a1_method_008",
                "speaker_id": "brin_alder",
                "speaker_display": "Brin",
                "text_en": "We need a solid footing, not a taller barrier.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a1_method_009",
                "speaker_id": "nixie_vale",
                "speaker_display": "Nixie",
                "text_en": "I will check both approaches while you choose it.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a1_method_010",
                "speaker_id": "fadyme",
                "speaker_display": "Fadyme",
                "text_en": "Then neither of you has to watch everything.",
                "emotion": "gentle",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "lt_a2_scout_1",
      "act": 2,
      "title_en": "The Turn in the Leaves",
      "location_id": "lt_scout_bend",
      "direction_en": "Nixie stays in sight. Leaves cross a trail of dragging marks. All environmental clues are described in text, not hidden touch targets.",
      "purpose_tr": "Sabit ipucu sunumu; pixel hunt, gizli zamanlayıcı veya yeni bell lore yok.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a2_scout_1_001",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "See the leaves along the edge? Something crossed the soft ground after they fell.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_1_002",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "A heavy step?",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_1_003",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "A dragging one. And this mark keeps going after the turn.",
          "emotion": "serious",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_1_004",
          "speaker_id": "fadyme",
          "speaker_display": "Fadyme",
          "text_en": "We can read that part without following it.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_1_005",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "What else do you hear?",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_1_006",
          "speaker_id": "narrator",
          "speaker_display": "Narration",
          "text_en": "A faint knock comes from behind the bend. It does not follow the wind.",
          "emotion": "composed",
          "voice_track": "jp_narration"
        },
        {
          "line_id": "lt_a2_scout_1_007",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "Enough to choose what we watch first.",
          "emotion": "focused",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "lt_a2_scout_2",
      "act": 2,
      "title_en": "Two Ways to Check",
      "location_id": "lt_scout_bend",
      "direction_en": "Choose a visible observation. Both reveal a playable threat profile; neither gives a secret correct-answer reward.",
      "purpose_tr": "İki geçerli okuma. İpuçları NPC kimliği/borcu hakkında çıkarım yapmaz.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a2_scout_2_001",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "The track tells us where something can reach. The knock tells us where the dead turn together.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_2_002",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "We can prepare for one first, without forgetting the other.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_2_003",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "Choose it. We stay within sight.",
          "emotion": "calm",
          "voice_track": "jp"
        }
      ],
      "choice": {
        "prompt_en": "Which observation leads the preparation?",
        "state_key": "plan",
        "options": [
          {
            "id": "lt_plan_scout_tracks",
            "value": "scout_tracks",
            "text_en": "Inspect the dragging tracks — rear-line threat.",
            "consequence_en": "Battle profile emphasizes a reaching attacker; a bellbound support is still visible.",
            "lines": [
              {
                "line_id": "lt_a2_scout_2_004",
                "speaker_id": "nixie_vale",
                "speaker_display": "Nixie",
                "text_en": "The dragging staff can reach around the front. Keep the rear where we can protect it.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a2_scout_2_005",
                "speaker_id": "brin_alder",
                "speaker_display": "Brin",
                "text_en": "I can hold the nearest one while you choose the attacker.",
                "emotion": "calm",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a2_scout_2_006",
                "speaker_id": "fadyme",
                "speaker_display": "Fadyme",
                "text_en": "Then I will stay where both of you can see me.",
                "emotion": "focused",
                "voice_track": "jp"
              }
            ]
          },
          {
            "id": "lt_plan_scout_sound",
            "value": "scout_sound",
            "text_en": "Listen at the bend — support threat.",
            "consequence_en": "Battle profile emphasizes the bellbound support; reaching attacks remain visible.",
            "lines": [
              {
                "line_id": "lt_a2_scout_2_007",
                "speaker_id": "nixie_vale",
                "speaker_display": "Nixie",
                "text_en": "The knock comes before the others move. We will see the bellbound one as soon as we step out.",
                "emotion": "serious",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a2_scout_2_008",
                "speaker_id": "mahmut",
                "speaker_display": "Mahmut",
                "text_en": "A target to notice. Not a reason to chase without checking the lane.",
                "emotion": "focused",
                "voice_track": "jp"
              },
              {
                "line_id": "lt_a2_scout_2_009",
                "speaker_id": "brin_alder",
                "speaker_display": "Brin",
                "text_en": "I will keep the space behind us clear.",
                "emotion": "calm",
                "voice_track": "jp"
              }
            ]
          }
        ]
      }
    },
    {
      "scene_id": "lt_a2_scout_3",
      "act": 2,
      "title_en": "A Mark before the Bend",
      "location_id": "lt_forest_junction",
      "direction_en": "Nixie tests an arrow from the direction a new traveler will approach. The sign marks safe space, not a magic seal.",
      "purpose_tr": "Keşif yaklaşımının sonuç hazırlığı; savaş öncesi birleşir.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a2_scout_3_001",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "Here. They can see it before the turn.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_3_002",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "Not where you were standing when you drew it.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_3_003",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "You checked it from the other side.",
          "emotion": "small_smile",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_3_004",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "That is where someone will need it.",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_3_005",
          "speaker_id": "fadyme",
          "speaker_display": "Fadyme",
          "text_en": "A map improved by having more than one pair of feet.",
          "emotion": "wry",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_scout_3_006",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "We have the observation. Now we clear the passage.",
          "emotion": "focused",
          "voice_track": "jp"
        }
      ]
    },
    {
      "scene_id": "lt_a2_brace_1",
      "act": 2,
      "title_en": "The Footing",
      "location_id": "lt_brace_bank",
      "direction_en": "Brin compares a firm bank and a fallen beam. Both are intact enough to use. No engineering minigame or endangered NPC stands under them.",
      "purpose_tr": "Tek başına dayanma motifine küçük katkı; Two Roofs gibi companion’ın merkezî seçimi kopyalanmaz.",
      "music_cue": "lt_work",
      "provenance_kind": "new_authored_expansion",
      "lines": [
        {
          "line_id": "lt_a2_brace_1_001",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "The bank is firm. The beam is dry underneath.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_brace_1_002",
          "speaker_id": "nixie_vale",
          "speaker_display": "Nixie",
          "text_en": "The narrow side is open from both. We can see the turn.",
          "emotion": "focused",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_brace_1_003",
          "speaker_id": "mahmut",
          "speaker_display": "Mahmut",
          "text_en": "Which place lets you share the work?",
          "emotion": "calm",
          "voice_track": "jp"
        },
        {
          "line_id": "lt_a2_brace_1_004",
          "speaker_id": "brin_alder",
          "speaker_display": "Brin",
          "text_en": "Either, if someone watches the side I cannot.",
          "emotion": "quiet",
          "voice_track": "jp"
        },
        {
