                "voice_track": "jp"
              },
              {
                "line_id": "lt_a4_company_010",
                "speaker_id": "nixie_vale",
                "speaker_display": "Nixie",
                "text_en": "After you looked.",
                "emotion": "small_smile",
                "voice_track": "jp"
              },
