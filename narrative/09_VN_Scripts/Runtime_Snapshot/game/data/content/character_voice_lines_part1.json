{
  "schema_version": 1,
  "pack_id": "part1_character_voice_lines",
  "content_language": "en",
  "voice_language": "ja",
  "rules_tr": "GDD JP ses planındaki karakter başı satır seti: ilk karşılaşma, takım kurma, idle, temel saldırı, aktif, ultimate, zafer, yenilgi, düşük HP, iki ilişki satırı. Savaş satırları hız x2/x3'te kısaltılabilir.",
  "characters": [
    {
      "character_id": "mahmut",
      "lines": [
        {
          "line_id": "vo_mahmut_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Mahmut. No title. The crest came off years ago. The shield did not.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_team_join",
          "trigger": "team_join",
          "text_en": "Front line. Mine.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_idle",
          "trigger": "idle",
          "text_en": "If you are waiting for me to rest, it will be a long wait.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Hold.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_active_skill",
          "trigger": "active_skill",
          "text_en": "Behind me.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_ultimate",
          "trigger": "ultimate",
          "text_en": "Last wall. Stand fast!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_victory",
          "trigger": "victory",
          "text_en": "Everyone up? Good.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_defeat",
          "trigger": "defeat",
          "text_en": "...I was too slow.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_low_hp",
          "trigger": "low_hp",
          "text_en": "Not yet.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mahmut_relationship_1",
          "trigger": "relationship_1",
          "text_en": "She says she is fine. I have learned to count how often.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"1-5"}
        },
        {
          "line_id": "vo_mahmut_relationship_2",
          "trigger": "relationship_2",
          "text_en": "He taught me the shield. I will not thank him for the rest.",
          "voice_track": "jp",
          "about_character_id": null,
          "about": "oren",
          "unlock":{"after_stage":"5-5"}
        }
      ]
    },
    {
      "character_id": "fadyme",
      "lines": [
        {
          "line_id": "vo_fadyme_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Fadyme. Just Fadyme, for now. The rest of the name is heavier than it looks.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_team_join",
          "trigger": "team_join",
          "text_en": "I will be right behind him. Someone has to be.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_idle",
          "trigger": "idle",
          "text_en": "If I sit still long enough, I can hear every bell in the kingdom. Please talk to me.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Thorn.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_active_skill",
          "trigger": "active_skill",
          "text_en": "Borrow this hour.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_ultimate",
          "trigger": "ultimate",
          "text_en": "Listen—the bell forgets!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_victory",
          "trigger": "victory",
          "text_en": "We all walk away. That is the only victory I count.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_defeat",
          "trigger": "defeat",
          "text_en": "I am... fine...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_low_hp",
          "trigger": "low_hp",
          "text_en": "I am perfectly fine.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_fadyme_relationship_1",
          "trigger": "relationship_1",
          "text_en": "He cuts cheese like it owes the Crown money.",
          "voice_track": "jp",
          "about_character_id": "mahmut",
          "about": "mahmut",
          "unlock":{"after_stage":"6-5"}
        },
        {
          "line_id": "vo_fadyme_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Clem keeps my name in her book. I hope she has good ink.",
          "voice_track": "jp",
          "about_character_id": "clem_marr",
          "about": "clem_marr",
          "unlock":{"after_stage":"7-5"}
        }
      ]
    },
    {
      "character_id": "kera_voss",
      "lines": [
        {
          "line_id": "vo_kera_voss_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Kera Voss, Red Vial archive. Before you ask: no, it will not explode. Probably.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_team_join",
          "trigger": "team_join",
          "text_en": "Rear line. Where the explosions are safe.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_idle",
          "trigger": "idle",
          "text_en": "Hold this. No, not that one.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Flick!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_active_skill",
          "trigger": "active_skill",
          "text_en": "Cinder tonic, measured!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_ultimate",
          "trigger": "ultimate",
          "text_en": "Redoubt reaction—stand back!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_victory",
          "trigger": "victory",
          "text_en": "Results recorded. Excellent results.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_defeat",
          "trigger": "defeat",
          "text_en": "Incorrect... mixture...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_low_hp",
          "trigger": "low_hp",
          "text_en": "I need a minute. Do not touch my bag.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_kera_voss_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I am finishing her formula. Stop asking me when.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"4-4"}
        },
        {
          "line_id": "vo_kera_voss_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Tilda says I label things like a threat. Correct.",
          "voice_track": "jp",
          "about_character_id": "tilda_fen",
          "about": "tilda_fen",
          "unlock":{"after_stage":"4-2"}
        }
      ]
    },
    {
      "character_id": "brin_alder",
      "lines": [
        {
          "line_id": "vo_brin_alder_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Brin Alder. I hold things up.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_team_join",
          "trigger": "team_join",
          "text_en": "I will stand in front.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_idle",
          "trigger": "idle",
          "text_en": "The fire needs wood. I will get it.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Chop.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_active_skill",
          "trigger": "active_skill",
          "text_en": "Brace.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_ultimate",
          "trigger": "ultimate",
          "text_en": "Alderwall!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_victory",
          "trigger": "victory",
          "text_en": "Everyone is here.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_defeat",
          "trigger": "defeat",
          "text_en": "Could not... hold...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_low_hp",
          "trigger": "low_hp",
          "text_en": "Still standing.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_brin_alder_relationship_1",
          "trigger": "relationship_1",
          "text_en": "He told me I did not have to hold it alone. I am still learning that.",
          "voice_track": "jp",
          "about_character_id": "mahmut",
          "about": "mahmut",
          "unlock":{"after_stage":"1-2"}
        },
        {
          "line_id": "vo_brin_alder_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Jori builds doors. I stand in them.",
          "voice_track": "jp",
          "about_character_id": "jori_flint",
          "about": "jori_flint",
          "unlock":{"after_stage":"3-4"}
        }
      ]
    },
    {
      "character_id": "nixie_vale",
      "lines": [
        {
          "line_id": "vo_nixie_vale_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Nixie Vale! Scout, archer, professional tree-climber. Where are we going?",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_team_join",
          "trigger": "team_join",
          "text_en": "Rear watch, got it!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_idle",
          "trigger": "idle",
          "text_en": "Is anyone else bored? I could scout. I could scout right now.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Needle!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_active_skill",
          "trigger": "active_skill",
          "text_en": "Crossdraft!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_ultimate",
          "trigger": "ultimate",
          "text_en": "Hawk over the pass!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_victory",
          "trigger": "victory",
          "text_en": "Marked, tracked, done!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_defeat",
          "trigger": "defeat",
          "text_en": "Should have... checked the map...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_low_hp",
          "trigger": "low_hp",
          "text_en": "Okay. Okay. Breathe.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nixie_vale_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Pippa wrote a song about my register page. It is annoyingly good.",
          "voice_track": "jp",
          "about_character_id": "pippa_bell",
          "about": "pippa_bell",
          "unlock":{"after_stage":"3-4"}
        },
        {
          "line_id": "vo_nixie_vale_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Odelia follows tracks. I make them. We get along.",
          "voice_track": "jp",
          "about_character_id": "odelia_pike",
          "about": "odelia_pike",
          "unlock":{"after_stage":"4-1"}
        }
      ]
    },
    {
      "character_id": "sister_aveline",
      "lines": [
        {
          "line_id": "vo_sister_aveline_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Sister Aveline of Saint Luthos. People first. Questions after.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_team_join",
          "trigger": "team_join",
          "text_en": "The candles stay lit behind you.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_idle",
          "trigger": "idle",
          "text_en": "Has everyone eaten? Then eat again.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Mercy.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_active_skill",
          "trigger": "active_skill",
          "text_en": "Be still. Be healed.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_ultimate",
          "trigger": "ultimate",
          "text_en": "Matins at the last door!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_victory",
          "trigger": "victory",
          "text_en": "Count heads. Twice.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_defeat",
          "trigger": "defeat",
          "text_en": "Forgive me... one candle out...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_low_hp",
          "trigger": "low_hp",
          "text_en": "I am not leaving this door.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sister_aveline_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I am keeping vigil. She pretends not to notice.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_sister_aveline_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Mirel corrects records. I correct prayers. We are both unpopular with the clergy.",
          "voice_track": "jp",
          "about_character_id": "mirel_quill",
          "about": "mirel_quill",
          "unlock":{"after_stage":"7-3"}
        }
      ]
    },
    {
      "character_id": "sable_wren",
      "lines": [
        {
          "line_id": "vo_sable_wren_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Sable. Courier. You will not need my other names.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_team_join",
          "trigger": "team_join",
          "text_en": "I will be where you are not looking.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_idle",
          "trigger": "idle",
          "text_en": "...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Point.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_active_skill",
          "trigger": "active_skill",
          "text_en": "Cut the thread.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_ultimate",
          "trigger": "ultimate",
          "text_en": "Name taken. In silence.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_victory",
          "trigger": "victory",
          "text_en": "Clear.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_defeat",
          "trigger": "defeat",
          "text_en": "Should not... have opened it...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_low_hp",
          "trigger": "low_hp",
          "text_en": "Still here.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_sable_wren_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Hana kept a secret for someone. I told her mine.",
          "voice_track": "jp",
          "about_character_id": "hana_birch",
          "about": "hana_birch",
          "unlock":{"after_stage":"7-4"}
        },
        {
          "line_id": "vo_sable_wren_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Rikka is loud. It is restful, somehow.",
          "voice_track": "jp",
          "about_character_id": "rikka_ember",
          "about": "rikka_ember",
          "unlock":{"after_stage":"5-3"}
        }
      ]
    },
    {
      "character_id": "tilda_fen",
      "lines": [
        {
          "line_id": "vo_tilda_fen_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Tilda Fen. Healer. If you are bleeding, sit. If you are not, move.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_team_join",
          "trigger": "team_join",
          "text_en": "Behind the line. Where the patients will be.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_idle",
          "trigger": "idle",
          "text_en": "Nobody is injured? Suspicious.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Tap.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_active_skill",
          "trigger": "active_skill",
          "text_en": "Poultice. Hold still.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_ultimate",
          "trigger": "ultimate",
          "text_en": "Rain on the salt road.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_victory",
          "trigger": "victory",
          "text_en": "Everyone breathing. Good enough.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_defeat",
          "trigger": "defeat",
          "text_en": "Not... my... patient...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_low_hp",
          "trigger": "low_hp",
          "text_en": "I have treated worse. On myself.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_tilda_fen_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Kera labels things like threats. The labels are accurate.",
          "voice_track": "jp",
          "about_character_id": "kera_voss",
          "about": "kera_voss",
          "unlock":{"after_stage":"4-2"}
        },
        {
          "line_id": "vo_tilda_fen_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Iona listens. I prescribe. Between us, a healer.",
          "voice_track": "jp",
          "about_character_id": "iona_mist",
          "about": "iona_mist",
          "unlock":{"after_stage":"4-2"}
        }
      ]
    },
    {
      "character_id": "rikka_ember",
      "lines": [
        {
          "line_id": "vo_rikka_ember_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Rikka Ember of the kiln company! Loud, bright, and very good with a spear!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_team_join",
          "trigger": "team_join",
          "text_en": "Front! Always front!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_idle",
          "trigger": "idle",
          "text_en": "Is it quiet? I hate quiet. Somebody hum.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Hya!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_active_skill",
          "trigger": "active_skill",
          "text_en": "Furnace lunge!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_ultimate",
          "trigger": "ultimate",
          "text_en": "Procession of sparks! Everybody cheer!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_victory",
          "trigger": "victory",
          "text_en": "Held is held!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_defeat",
          "trigger": "defeat",
          "text_en": "Not... so loud now...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_low_hp",
          "trigger": "low_hp",
          "text_en": "Still burning!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_rikka_ember_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Brin says my barricades are on fire. They are warm.",
          "voice_track": "jp",
          "about_character_id": "brin_alder",
          "about": "brin_alder",
          "unlock":{"after_stage":"7-2"}
        },
        {
          "line_id": "vo_rikka_ember_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Sable never laughs. I am working on it.",
          "voice_track": "jp",
          "about_character_id": "sable_wren",
          "about": "sable_wren",
          "unlock":{"after_stage":"5-3"}
        }
      ]
    },
    {
      "character_id": "mirel_quill",
      "lines": [
        {
          "line_id": "vo_mirel_quill_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Mirel Quill, archivist. I correct records. Some of them, my own.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_team_join",
          "trigger": "team_join",
          "text_en": "The ledger stays in the rear. So do I.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_idle",
          "trigger": "idle",
          "text_en": "A footnote, if you have a moment. You do not? Pity.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Inkline.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_active_skill",
          "trigger": "active_skill",
          "text_en": "A note in the margin.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_ultimate",
          "trigger": "ultimate",
          "text_en": "Decree of the unfallen!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_victory",
          "trigger": "victory",
          "text_en": "Recorded. Correctly, this time.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_defeat",
          "trigger": "defeat",
          "text_en": "The record... ends here...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_low_hp",
          "trigger": "low_hp",
          "text_en": "Not the last page.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_mirel_quill_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I wrote her name back with my own hand. It was the only amends I had.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-3"}
        },
        {
          "line_id": "vo_mirel_quill_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Aveline is editing scripture. I am very proud.",
          "voice_track": "jp",
          "about_character_id": "sister_aveline",
          "about": "sister_aveline",
          "unlock":{"after_stage":"7-3"}
        }
      ]
    },
    {
      "character_id": "odelia_pike",
      "lines": [
        {
          "line_id": "vo_odelia_pike_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Odelia Pike. I... I follow tracks. Harbor-born.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_team_join",
          "trigger": "team_join",
          "text_en": "Rear. I see better from back here.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_idle",
          "trigger": "idle",
          "text_en": "That footprint is new. Do you see it? No? Only me?",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Mark.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_active_skill",
          "trigger": "active_skill",
          "text_en": "Pinned.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_ultimate",
          "trigger": "ultimate",
          "text_en": "Breakwater volley!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_victory",
          "trigger": "victory",
          "text_en": "Track answered.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_defeat",
          "trigger": "defeat",
          "text_en": "Lost... the trail...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_low_hp",
          "trigger": "low_hp",
          "text_en": "Keep going. Keep going.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_odelia_pike_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Mirel read my brother's name. I owe her more than I can say.",
          "voice_track": "jp",
          "about_character_id": "mirel_quill",
          "about": "mirel_quill",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_odelia_pike_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Nixie makes tracks faster than I can read them.",
          "voice_track": "jp",
          "about_character_id": "nixie_vale",
          "about": "nixie_vale",
          "unlock":{"after_stage":"4-1"}
        }
      ]
    },
    {
      "character_id": "pippa_bell",
      "lines": [
        {
          "line_id": "vo_pippa_bell_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Pippa Bell, traveling singer! Every name gets a verse!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_team_join",
          "trigger": "team_join",
          "text_en": "Rear, where the audience is safest!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_idle",
          "trigger": "idle",
          "text_en": "This is a very long intermission.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Plink!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_active_skill",
          "trigger": "active_skill",
          "text_en": "Rally refrain!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_ultimate",
          "trigger": "ultimate",
          "text_en": "A song for the long road!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_victory",
          "trigger": "victory",
          "text_en": "Encore! Encore!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_defeat",
          "trigger": "defeat",
          "text_en": "Out... of tune...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_low_hp",
          "trigger": "low_hp",
          "text_en": "The show goes on!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_pippa_bell_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Nixie pretends she hates my songs. She hums them.",
          "voice_track": "jp",
          "about_character_id": "nixie_vale",
          "about": "nixie_vale",
          "unlock":{"after_stage":"3-4"}
        },
        {
          "line_id": "vo_pippa_bell_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Veyr rhymes with stayed here. Close enough.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-3"}
        }
      ]
    },
    {
      "character_id": "nara_vell",
      "lines": [
        {
          "line_id": "vo_nara_vell_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Nara Vell, bridge warden. Everyone crosses.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_team_join",
          "trigger": "team_join",
          "text_en": "Front. Measure the gap for me.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_idle",
          "trigger": "idle",
          "text_en": "Eleven seconds of silence. Twelve.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Bash.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_active_skill",
          "trigger": "active_skill",
          "text_en": "Shelter angle.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_ultimate",
          "trigger": "ultimate",
          "text_en": "The narrow gate holds!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_victory",
          "trigger": "victory",
          "text_en": "Last cart across.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_defeat",
          "trigger": "defeat",
          "text_en": "The stone... was not enough...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_low_hp",
          "trigger": "low_hp",
          "text_en": "Recount. Hold.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_nara_vell_relationship_1",
          "trigger": "relationship_1",
          "text_en": "He is looking for Oren. I told him the truth. It was not enough.",
          "voice_track": "jp",
          "about_character_id": "mahmut",
          "about": "mahmut",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_nara_vell_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Marek's rhythm is off by a half-step on hills. On purpose.",
          "voice_track": "jp",
          "about_character_id": "marek_vane",
          "about": "marek_vane",
          "unlock":{"after_stage":"5-2"}
        }
      ]
    },
    {
      "character_id": "clem_marr",
      "lines": [
        {
          "line_id": "vo_clem_marr_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Clem Marr! I read graves. Do not worry, only the old ones.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_team_join",
          "trigger": "team_join",
          "text_en": "Rear, with the lantern.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_idle",
          "trigger": "idle",
          "text_en": "Did you know every stone here has a name under the moss?",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Scratch.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_active_skill",
          "trigger": "active_skill",
          "text_en": "Grave index.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_ultimate",
          "trigger": "ultimate",
          "text_en": "Epitaph in reverse!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_victory",
          "trigger": "victory",
          "text_en": "Everyone has a name. Everyone keeps it.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_defeat",
          "trigger": "defeat",
          "text_en": "Forgot... to write it down...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_low_hp",
          "trigger": "low_hp",
          "text_en": "Not a grave yet!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_clem_marr_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I keep her name in my book. Every day. Best hand.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_clem_marr_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Hana and I are going back for the unmarked row.",
          "voice_track": "jp",
          "about_character_id": "hana_birch",
          "about": "hana_birch",
          "unlock":{"after_stage":"6-1"}
        }
      ]
    },
    {
      "character_id": "vespera_wisp",
      "lines": [
        {
          "line_id": "vo_vespera_wisp_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Vespera. I study the glass. It studies me back.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_team_join",
          "trigger": "team_join",
          "text_en": "I will burn from the rear.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_idle",
          "trigger": "idle",
          "text_en": "The light here is an hour old. Hm.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Spark.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_active_skill",
          "trigger": "active_skill",
          "text_en": "Pale orbit.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_ultimate",
          "trigger": "ultimate",
          "text_en": "Procession of pale lights.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_victory",
          "trigger": "victory",
          "text_en": "Time spent well.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_defeat",
          "trigger": "defeat",
          "text_en": "Too... late... again...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_low_hp",
          "trigger": "low_hp",
          "text_en": "The morning can wait.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_vespera_wisp_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Iona asked what it cost. She is the only one who asked.",
          "voice_track": "jp",
          "about_character_id": "iona_mist",
          "about": "iona_mist",
          "unlock":{"after_stage":"6-3"}
        },
        {
          "line_id": "vo_vespera_wisp_relationship_2",
          "trigger": "relationship_2",
          "text_en": "He wants to consent to something he does not understand. I will not let him.",
          "voice_track": "jp",
          "about_character_id": "mahmut",
          "about": "mahmut",
          "unlock":{"after_stage":"7-5"}
        }
      ]
    },
    {
      "character_id": "hana_birch",
      "lines": [
        {
          "line_id": "vo_hana_birch_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Hana Birch. I... watch the traps. Hello.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_team_join",
          "trigger": "team_join",
          "text_en": "I can stand in front. If you need.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_idle",
          "trigger": "idle",
          "text_en": "The wind changed. Sorry. I notice these things.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Snap.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_active_skill",
          "trigger": "active_skill",
          "text_en": "Snare set.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_ultimate",
          "trigger": "ultimate",
          "text_en": "Birchline ambush!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_victory",
          "trigger": "victory",
          "text_en": "Everyone is outside. Good.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_defeat",
          "trigger": "defeat",
          "text_en": "Hands... shaking...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_low_hp",
          "trigger": "low_hp",
          "text_en": "Still. Stay still.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_hana_birch_relationship_1",
          "trigger": "relationship_1",
          "text_en": "Sable told me a secret. I will carry it with the other one.",
          "voice_track": "jp",
          "about_character_id": "sable_wren",
          "about": "sable_wren",
          "unlock":{"after_stage":"7-4"}
        },
        {
          "line_id": "vo_hana_birch_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Clem says every grave gets a 'here'. I agree.",
          "voice_track": "jp",
          "about_character_id": "clem_marr",
          "about": "clem_marr",
          "unlock":{"after_stage":"6-1"}
        }
      ]
    },
    {
      "character_id": "thistle_roe",
      "lines": [
        {
          "line_id": "vo_thistle_roe_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Th-Thistle Roe. Bell gardener. I grow things. Mostly.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_team_join",
          "trigger": "team_join",
          "text_en": "Rear. W-with the herbs.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_idle",
          "trigger": "idle",
          "text_en": "This moss is lovely. Sorry. Yes. Fighting.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Seed!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_active_skill",
          "trigger": "active_skill",
          "text_en": "Windgrown herb.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_ultimate",
          "trigger": "ultimate",
          "text_en": "Garden before winter!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_victory",
          "trigger": "victory",
          "text_en": "Everyone mended.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_defeat",
          "trigger": "defeat",
          "text_en": "The frost... came early...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_low_hp",
          "trigger": "low_hp",
          "text_en": "I can m-mend this.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_thistle_roe_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I gave her winter seeds. Somebody sees the spring.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_thistle_roe_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Iona says I do not stammer when my hands know what to do.",
          "voice_track": "jp",
          "about_character_id": "iona_mist",
          "about": "iona_mist",
          "unlock":{"after_stage":"7-4"}
        }
      ]
    },
    {
      "character_id": "iona_mist",
      "lines": [
        {
          "line_id": "vo_iona_mist_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Iona Mist, river lantern keeper. No one crosses the fog alone.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_team_join",
          "trigger": "team_join",
          "text_en": "Rear. A lantern needs a keeper.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_idle",
          "trigger": "idle",
          "text_en": "Tell me a name. Any name. I will remember it.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Touch.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_active_skill",
          "trigger": "active_skill",
          "text_en": "Fogbound remedy.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_ultimate",
          "trigger": "ultimate",
          "text_en": "Safe harbor in fog.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_victory",
          "trigger": "victory",
          "text_en": "All ashore.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_defeat",
          "trigger": "defeat",
          "text_en": "The lantern... is out...",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_low_hp",
          "trigger": "low_hp",
          "text_en": "I am still listening.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_iona_mist_relationship_1",
          "trigger": "relationship_1",
          "text_en": "I say her name every night. She corrects my pronunciation.",
          "voice_track": "jp",
          "about_character_id": "fadyme",
          "about": "fadyme",
          "unlock":{"after_stage":"7-5"}
        },
        {
          "line_id": "vo_iona_mist_relationship_2",
          "trigger": "relationship_2",
          "text_en": "Tilda heals the living. I bring home the lost. We share a table.",
          "voice_track": "jp",
          "about_character_id": "tilda_fen",
          "about": "tilda_fen",
          "unlock":{"after_stage":"4-2"}
        }
      ]
    },
    {
      "character_id": "jori_flint",
      "lines": [
        {
          "line_id": "vo_jori_flint_first_meeting",
          "trigger": "first_meeting",
          "text_en": "Jori Flint. Smith. I make shields, not chains. Remember that.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_team_join",
          "trigger": "team_join",
          "text_en": "Front. Obviously.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_idle",
          "trigger": "idle",
          "text_en": "If you are going to stand around, hand me that rivet.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_basic_attack",
          "trigger": "basic_attack",
          "text_en": "Tap!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_active_skill",
          "trigger": "active_skill",
          "text_en": "Forgeguard!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_ultimate",
          "trigger": "ultimate",
          "text_en": "Furnace door—shut!",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_victory",
          "trigger": "victory",
          "text_en": "Door held.",
          "voice_track": "jp"
        },
        {
          "line_id": "vo_jori_flint_defeat",
          "trigger": "defeat",
          "text_en": "The rivet... gave...",
