    "per_round_limit_scope": "one_trigger_per_cycle",
    "cooldown_decrements_at_owner_turn_start": true,
    "new_wave_gauge": "living units keep current gauge; newly spawned wave enemies start at zero gauge"
  },
  "stat_resolution": {
    "character_base_stat": "base_stats_level_1 + growth_per_level * (level - 1)",
