{
  "schema_version": 1,
  "pack_id": "part1_events",
  "content_language": "en",
  "voice_language": "ja",
  "rules_tr": "GDD'deki 4 sezonluk lonca/saray etkinlik şablonunun canon hikâyeleri. Ödül ve süre ekonomisi economy_part1.json'a göre teknik ekipçe bağlanır.",
  "events": [
    {
      "event_id": "event_harvest_inn_meal",
      "title_en": "The Red Harvest Supper",
      "event_type": "festival",
      "canon_status": "canon",
      "timeline_placement": "after stage 3-5",
      "unlock": {
        "after_stage": "3-5"
      },
      "purpose_en": "Oakhaven's first festival after the mercenaries. Daily life, comedy and names; explains the Inn Meal custom.",
      "featured_character_ids": [
        "nixie_vale",
        "pippa_bell",
        "jori_flint",
        "kera_voss"
      ],
      "scenes": [
        {
          "scene_id": "event_harvest_inn_meal_1",
          "title_en": "A Table for Everyone",
          "location_id": "oakhaven_square",
          "direction_en": "The square is set with long tables. Every guest must bring one dish and one name.",
          "lines": [
            {
              "line_id": "event_harvest_inn_meal_1_001",
              "speaker_id": "pippa_bell",
              "speaker_display": "Pippa",
              "text_en": "Rule of the Harvest Supper: one dish, one name. You say the name, you get a bowl.",
              "emotion": "bright",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_1_002",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "I brought a dish. It is technically soup.",
              "emotion": "defensive",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_1_003",
              "speaker_id": "jori_flint",
              "speaker_display": "Jori",
              "text_en": "It is moving.",
              "emotion": "horrified",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_1_004",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "It is effervescent.",
              "emotion": "tsundere",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_1_005",
              "speaker_id": "nixie_vale",
              "speaker_display": "Nixie",
              "text_en": "I will eat it! For the festival!",
              "emotion": "heroic",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_1_006",
              "speaker_id": "narrator",
              "speaker_display": "Narration",
              "text_en": "Nixie ate it. Nixie was fine. Nixie glowed faintly for an hour.",
              "emotion": "comic",
              "voice_track": "jp_narration"
            }
          ]
        },
        {
          "scene_id": "event_harvest_inn_meal_2",
          "title_en": "The Inn Meal",
          "location_id": "oakhaven_inn",
          "direction_en": "The innkeeper explains why every traveler gets a free meal twice a day.",
          "lines": [
            {
              "line_id": "event_harvest_inn_meal_2_001",
              "speaker_id": "oakhaven_innkeeper",
              "speaker_display": "Innkeeper",
              "text_en": "After Crownfall, travelers stopped paying. So we stopped charging. Twice a day, a meal, no coin.",
              "emotion": "warm",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_2_002",
              "speaker_id": "fadyme",
              "speaker_display": "Fadyme",
              "text_en": "That is generous.",
              "emotion": "touched",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_2_003",
              "speaker_id": "oakhaven_innkeeper",
              "speaker_display": "Innkeeper",
              "text_en": "It is practical. A fed traveler says their name at the door. A hungry one slips past the register.",
              "emotion": "wry",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_2_004",
              "speaker_id": "mahmut",
              "speaker_display": "Mahmut",
              "text_en": "So the meal is a count.",
              "emotion": "observant",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_2_005",
              "speaker_id": "oakhaven_innkeeper",
              "speaker_display": "Innkeeper",
              "text_en": "The meal is a meal, knight. The count is a bonus.",
              "emotion": "laughing",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_harvest_inn_meal_3",
          "title_en": "Last Song",
          "location_id": "oakhaven_square",
          "direction_en": "Late night. Pippa leads the square in a song of every name collected.",
          "lines": [
            {
              "line_id": "event_harvest_inn_meal_3_001",
              "speaker_id": "pippa_bell",
              "speaker_display": "Pippa",
              "text_en": "Last verse! Everyone who brought a name, sing it with me!",
              "emotion": "joyful",
              "voice_track": "jp"
            },
            {
              "line_id": "event_harvest_inn_meal_3_002",
              "speaker_id": "narrator",
              "speaker_display": "Narration",
              "text_en": "Two hundred voices, off-key and loud. Somewhere, a bell rang, and nobody stopped singing.",
              "emotion": "warm",
              "voice_track": "jp_narration"
            },
            {
              "line_id": "event_harvest_inn_meal_3_003",
              "speaker_id": "fadyme_thought",
              "speaker_display": "Fadyme (thought)",
              "text_en": "The bell cannot count a square this loud. For one night, it is losing.",
              "emotion": "content",
              "voice_track": "jp_inner"
            }
          ]
        }
      ]
    },
    {
      "event_id": "event_sun_eclipse_day",
      "title_en": "The Day the Eclipse Breathes",
      "event_type": "mystery",
      "canon_status": "canon",
      "timeline_placement": "after stage 6-5",
      "unlock": {
        "after_stage": "6-5"
      },
      "purpose_en": "A folk holy day when the eclipse is said to move. Foreshadows the altar, the cult and the Law of Hours.",
      "featured_character_ids": [
        "vespera_wisp",
        "thistle_roe",
        "clem_marr"
      ],
      "scenes": [
        {
          "scene_id": "event_sun_eclipse_day_1",
          "title_en": "An Old Holy Day",
          "location_id": "eastern_highland_road",
          "direction_en": "On their own safe route to the altar, Clem, Vespera and Thistle join highland villagers climbing to watch the far mountain where the eclipse hangs.",
          "lines": [
            {
              "line_id": "event_sun_eclipse_day_1_001",
              "speaker_id": "clem_marr",
              "speaker_display": "Clem",
              "text_en": "Sun-Eclipse Day. Once a year the villages say the black sun breathes.",
              "emotion": "curious",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_1_002",
              "speaker_id": "vespera_wisp",
              "speaker_display": "Vespera",
              "text_en": "Does it?",
              "emotion": "dry",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_1_003",
              "speaker_id": "clem_marr",
              "speaker_display": "Clem",
              "text_en": "Every grave-keeper's record says yes. Every scholar's says no. I trust grave-keepers.",
              "emotion": "cheerful",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_sun_eclipse_day_2",
          "title_en": "The Breath",
          "location_id": "highland_ridge",
          "direction_en": "At noon the eclipse's rim flickers. Every bell pin, charm and bell in the valley hums at once.",
          "lines": [
            {
              "line_id": "event_sun_eclipse_day_2_001",
              "speaker_id": "thistle_roe",
              "speaker_display": "Thistle",
              "text_en": "The owing-bells are all opening. All of them. The whole ridge.",
              "emotion": "frightened",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_2_002",
              "speaker_id": "vespera_wisp",
              "speaker_display": "Vespera",
              "text_en": "It is not breathing. It is recounting. Every owed hour in the valley, checked at once.",
              "emotion": "grave",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_2_003",
              "speaker_id": "thistle_roe",
              "speaker_display": "Thistle",
              "text_en": "Why t-today?",
              "emotion": "tense",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_2_004",
              "speaker_id": "vespera_wisp",
              "speaker_display": "Vespera",
              "text_en": "Because someone set a day for it. Machines keep calendars. So do chancellors.",
              "emotion": "quiet",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_sun_eclipse_day_3",
          "title_en": "Tokens",
          "location_id": "highland_village",
          "direction_en": "The villagers give each traveler a stamped token so the eclipse will \"know they watched\".",
          "lines": [
            {
              "line_id": "event_sun_eclipse_day_3_001",
              "speaker_id": "clem_marr",
              "speaker_display": "Clem",
              "text_en": "Sun-Eclipse tokens. Superstition. I am keeping five.",
              "emotion": "delighted",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_3_002",
              "speaker_id": "thistle_roe",
              "speaker_display": "Thistle",
              "text_en": "Why five?",
              "emotion": "curious",
              "voice_track": "jp"
            },
            {
              "line_id": "event_sun_eclipse_day_3_003",
              "speaker_id": "clem_marr",
              "speaker_display": "Clem",
              "text_en": "One for each of us who watched. So somebody knows we were here.",
              "emotion": "gentle",
              "voice_track": "jp"
            }
          ]
        }
      ]
    },
    {
      "event_id": "event_guild_salt_fever",
      "title_en": "Guild Dispatch: Salt-Road Fever",
      "event_type": "guild",
      "canon_status": "canon",
      "timeline_placement": "after stage 4-5",
      "unlock": {
        "after_stage": "4-5"
      },
      "purpose_en": "The Red Vial archive wing's first public dispatch after the Matron. Faction development and Tilda/Odelia/Kera focus.",
      "featured_character_ids": [
        "tilda_fen",
        "iona_mist",
        "odelia_pike",
        "kera_voss"
      ],
      "scenes": [
        {
          "scene_id": "event_guild_salt_fever_1",
          "title_en": "A Dispatch Posted",
          "location_id": "undercity_antidote_archive",
          "direction_en": "Kera nails the archive wing's first public notice to its own door.",
          "lines": [
            {
              "line_id": "event_guild_salt_fever_1_001",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "Salt-road fever in the coastal villages. The ledger wing sold the cure. We are giving it away.",
              "emotion": "defiant",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_1_002",
              "speaker_id": "tilda_fen",
              "speaker_display": "Tilda",
              "text_en": "With what staff? You have three shelves and a temper.",
              "emotion": "dry",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_1_003",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "I have you, Iona, and a harbor archer who knows the coast.",
              "emotion": "smug",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_1_004",
              "speaker_id": "odelia_pike",
              "speaker_display": "Odelia",
              "text_en": "I did not agree to this.",
              "emotion": "hesitant",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_1_005",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "You agreed with your face.",
              "emotion": "tsundere",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_guild_salt_fever_2",
          "title_en": "The Coast Road",
          "location_id": "salt_road_coast",
          "direction_en": "The salt villages. Tilda treats patients; Odelia guides them through her old harbor.",
          "lines": [
            {
              "line_id": "event_guild_salt_fever_2_001",
              "speaker_id": "tilda_fen",
              "speaker_display": "Tilda",
              "text_en": "This is where I learned. My teacher treated this fever with salt and honesty.",
              "emotion": "reflective",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_2_002",
              "speaker_id": "odelia_pike",
              "speaker_display": "Odelia",
              "text_en": "My brother and I stole bread from that bakery.",
              "emotion": "small_smile",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_2_003",
              "speaker_id": "iona_mist",
              "speaker_display": "Iona",
              "text_en": "Then we will pay it back with medicine.",
              "emotion": "gentle",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_guild_salt_fever_3",
          "title_en": "Two Labels",
          "location_id": "salt_road_coast",
          "direction_en": "A ledger-wing agent arrives selling the same cure at ten times the price.",
          "lines": [
            {
              "line_id": "event_guild_salt_fever_3_001",
              "speaker_id": "red_vial_agent",
              "speaker_display": "Ledger Agent",
              "text_en": "You are ruining a market, alchemist.",
              "emotion": "cold",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_3_002",
              "speaker_id": "kera_voss",
              "speaker_display": "Kera",
              "text_en": "I am labeling it correctly. Yours says \"cure\". Mine says \"cure, free, and the name of who made it\".",
              "emotion": "fierce",
              "voice_track": "jp"
            },
            {
              "line_id": "event_guild_salt_fever_3_003",
              "speaker_id": "narrator",
              "speaker_display": "Narration",
              "text_en": "The villagers took Kera's bottles. The agent left with a full crate and an empty road.",
              "emotion": "satisfied",
              "voice_track": "jp_narration"
            }
          ]
        }
      ]
    },
    {
      "event_id": "event_council_herald",
      "title_en": "The Council's Herald",
      "event_type": "court",
      "canon_status": "canon",
      "timeline_placement": "after stage 6-5",
      "unlock": {
        "after_stage": "6-5"
      },
      "purpose_en": "A Council of Dukes herald arrives on the estate road. Court politics and Part II setup.",
      "featured_character_ids": [
        "marek_vane",
        "mirel_quill",
        "sable_wren",
        "nara_vell"
      ],
      "scenes": [
        {
          "scene_id": "event_council_herald_1",
          "title_en": "A Decree on the Road",
          "location_id": "eastern_village_square",
          "direction_en": "A Council herald reads a new decree in the square Marek once spoke in.",
          "lines": [
            {
              "line_id": "event_council_herald_1_001",
              "speaker_id": "council_herald",
              "speaker_display": "Council Herald",
              "text_en": "By the seven seals of the Council: any person claiming royal blood shall present themselves at the capital, or be recorded as an impostor.",
              "emotion": "formal",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_1_002",
              "speaker_id": "mirel_quill",
              "speaker_display": "Mirel",
              "text_en": "That is new ink. They know a claim is coming.",
              "emotion": "sharp",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_1_003",
              "speaker_id": "marek_vane",
              "speaker_display": "Marek",
              "text_en": "They have never needed to deny a heir before.",
              "emotion": "grave",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_council_herald_2",
          "title_en": "Seven Uncut Seals",
          "location_id": "eastern_village_square",
          "direction_en": "Sable lifts the decree from the herald's satchel while Nara blocks the view.",
          "lines": [
            {
              "line_id": "event_council_herald_2_001",
              "speaker_id": "sable_wren",
              "speaker_display": "Sable",
              "text_en": "Seven seals. All uncut. The Council agrees on something for once.",
              "emotion": "dry",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_2_002",
              "speaker_id": "mirel_quill",
              "speaker_display": "Mirel",
              "text_en": "And this is a court hand I know. The same scribe who wrote the erasure orders I copied.",
              "emotion": "stricken",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_2_003",
              "speaker_id": "nara_vell",
              "speaker_display": "Nara",
              "text_en": "Then the hand that removed her name is still in the capital.",
              "emotion": "measured",
              "voice_track": "jp"
            }
          ]
        },
        {
          "scene_id": "event_council_herald_3",
          "title_en": "Herald Against Herald",
          "location_id": "eastern_village_square",
          "direction_en": "Marek answers the Council herald in front of the square.",
          "lines": [
            {
              "line_id": "event_council_herald_3_001",
              "speaker_id": "marek_vane",
              "speaker_display": "Marek",
              "text_en": "You read what you are given. So did I. I stopped.",
              "emotion": "calm",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_3_002",
              "speaker_id": "council_herald",
              "speaker_display": "Council Herald",
              "text_en": "You were a herald of the Crown. You know the penalty.",
              "emotion": "threatening",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_3_003",
              "speaker_id": "marek_vane",
              "speaker_display": "Marek",
              "text_en": "I know the price. It is cheaper than reading false paper for the rest of my life.",
              "emotion": "steady",
              "voice_track": "jp"
            },
            {
              "line_id": "event_council_herald_3_004",
              "speaker_id": "narrator",
              "speaker_display": "Narration",
              "text_en": "The herald left. The decree stayed nailed to the post, and beneath it someone scratched: WHO GAVE THE ORDER?",
              "emotion": "tense",
              "voice_track": "jp_narration"
            }
          ]
        }
      ]
    }
  ]
}