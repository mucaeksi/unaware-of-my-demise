  "lines": [
    {
      "line_id": "tutorial_t1_before_003",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/before/lines/2",
      "text_en": "The stones have already claimed one boot.",
      "text_en_sha256": "3e0f62e62e552d745a2615ffbb2c273188e7290ee27d91bc2f22c6f1b587e5bd",
      "text_ja_JP": "その石にも、もう靴を片方取られたわ。",
      "text_ja_JP_sha256": "e2f3d3c512481fc4af0367817aa5329b7d9acfeb46628073794ab357bd2ae376",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_before_005",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/before/lines/4",
      "text_en": "You have a comforting way of counting disasters.",
      "text_en_sha256": "0b8599e9f640fb1a36ef588007579888cd170149f2edcd239e696e4c585f854d",
      "text_ja_JP": "災難を数えるのが、お上手ね。安心できる数え方だわ。",
      "text_ja_JP_sha256": "00df978d7e7fdbb9f0cba6205eecc1801829e2aa7cc187f4cbc4a0d3df65ebbf",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_before_007",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/before/lines/6",
      "text_en": "For the stone, or for the whole road?",
      "text_en_sha256": "af553ca815b926cb253d23fbbe899ccd9165e6933e3798acb33281b819d0ba06",
      "text_ja_JP": "その石を渡る間だけ？　それとも、この道の終わりまで？",
      "text_ja_JP_sha256": "c7f5c07b7911c99bc4685658aa331fcfc86b3b4af4bb48f8226ec4ab94d44e67",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_before_010",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/before/lines/9",
      "text_en": "There. An excellent rescue. Very little applause, unfortunately.",
      "text_en_sha256": "d6420b66625facc4bf14bb423488c13cce7a4edd5449581160ca02629fbb722b",
      "text_ja_JP": "ほら、見事な救出だったわ。残念ながら、拍手はほとんどないけれど。",
      "text_ja_JP_sha256": "0edb1f6aa93c29486843ebe66a701105e3cf59ff1f5d4be6f0a7907a23acbe34",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_before_014",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/before/lines/13",
      "text_en": "Beside it. Not behind you. I know the difference.",
      "text_en_sha256": "aa883c775b7df936af5c49cb67f9592c21b296b9ca57dd70b628c0eb96e42276",
      "text_ja_JP": "壁の横ね。あなたの後ろじゃなくて。その違いは分かっているわ。",
      "text_ja_JP_sha256": "67596f216b8fff9be72c19d613be1731bbc93f824d6c5fae441d970dadb4efef",
      "emotion": "determined",
      "voice_track": null,
      "expression": "resolve",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_after_003",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/after/lines/2",
      "text_en": "Only my opinion of this road.",
      "text_en_sha256": "77c38a75f6b28db2cc925f166086561b6634850c5fef9ab71550e2c891658ebb",
      "text_ja_JP": "この道への評価だけ、傷ついたわ。",
      "text_ja_JP_sha256": "271fdfe021d0f9913929a693f72a03c32fe549a9c2868702c90c9355238e8e35",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_after_005",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/after/lines/4",
      "text_en": "A branch. It has dreadful manners.",
      "text_en_sha256": "6c3772efbdff8bbfbec299c2ba9f635f8956f454a02fed252d61e1d7abfd433b",
      "text_ja_JP": "枝よ。ひどく行儀の悪い枝だったわ。",
      "text_ja_JP_sha256": "99b5f39198ef9f5049b02e8333c288e5bfb23c0aaca17254508a9dcb1d9b0d0a",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_after_008",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/after/lines/7",
      "text_en": "In the mud? I was hoping your invitation would improve.",
      "text_en_sha256": "09e10ad4656d23f0513a1c7fe6176cca2c9be6fbb2b7f7083020de5cd3560e13",
      "text_ja_JP": "泥の中で？　もう少し素敵なお誘いを期待していたのに。",
      "text_ja_JP_sha256": "39711901b2065e1dfea2341f3c1e35717b35f1f621a234e835b5e47ebd88eac3",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_after_010",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/after/lines/9",
      "text_en": "Tempting. A roof would make it irresistible.",
      "text_en_sha256": "803e36d6064b336b1a91751d69b8850373f04a7bcb71393b483eea4a313592dd",
      "text_ja_JP": "魅力的ね。屋根まであれば、断れなくなりそう。",
      "text_ja_JP_sha256": "0d41d8db661abd35f4668a53d9720148bbc0349dbceba0305d3e2a7fb35b6436",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t1_after_012",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/0/after/lines/11",
      "text_en": "If either of us needs to. That is the arrangement.",
      "text_en_sha256": "5d0697c12732704d5b6afc3ecf2c45eee6ca9dfa1ae36387ab25dc6fe5701796",
      "text_ja_JP": "どちらかが必要としたら、よ。そういう約束でしょう。",
      "text_ja_JP_sha256": "e4b97ab0dd6f819fe5efc266a4e2737562f260f0b9bc0ca1f2d7088a27d29bcd",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_before_003",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/before/lines/2",
      "text_en": "Perhaps the road used to end here.",
      "text_en_sha256": "4cb007d43dc45da79ed3869a696b1a7a8140cd0403ded6006a709e3f0b9b413a",
      "text_ja_JP": "昔は、ここが道の終わりだったのかもしれないわ。",
      "text_ja_JP_sha256": "353655e8585322a33e52f7cd88c7dd2e343712f619a696f1a06f0a7b93280da8",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_before_005",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/before/lines/4",
      "text_en": "No. Someone ought to tell it.",
      "text_en_sha256": "06c62234349d3482d7ceee508b55cd96dca0cb64a24f4fe730242b72163645a6",
      "text_ja_JP": "ええ。誰かが教えてあげないと。",
      "text_ja_JP_sha256": "44c527c9530a651c049bb90df1399664b2110ebf27240a737ac18c4c32f2ed0a",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_before_007",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/before/lines/6",
      "text_en": "Do you ever wonder where they meant to go?",
      "text_en_sha256": "9d552e9a60f08642ba8ea4b191620307ac4dc287adc9d86b184155ecdda799ae",
      "text_ja_JP": "あの人たちは、どこへ行くつもりだったのかしら。あなたも考えることはある？",
      "text_ja_JP_sha256": "16ea51ee646f5f44f348d9ff08373c3e5dc8ebaf84673ec683a0e8472ef3fb53",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_before_009",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/before/lines/8",
      "text_en": "I would rather we reached somewhere ordinary. With an especially ordinary supper.",
      "text_en_sha256": "acd9c14e9ae702c1f19a67341a9bb375488d00569db7eaad0fe06c57806dcf43",
      "text_ja_JP": "私たちは、ありふれた場所に着ければいいわ。夕食も、とびきりありふれたもので。",
      "text_ja_JP_sha256": "f564d797268e81e253e781bff6565c714706f710b034b4b2a69a220105202d2e",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_before_013",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/before/lines/12",
      "text_en": "And you keep room for me.",
      "text_en_sha256": "b49be5f54326e803b5160467ad19af9324d8225c441db5503b3e14bfca6fc243",
      "text_ja_JP": "あなたも、私の分は空けておいて。",
      "text_ja_JP_sha256": "a2c2770629d6c329c694bb58f44df00467b38208bea77c86134e25b647f74ae2",
      "emotion": "determined",
      "voice_track": null,
      "expression": "resolve",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_002",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/1",
      "text_en": "Sit. The trees have survived your inspection.",
      "text_en_sha256": "c348c4e4361d694d88441453b19252baf5a549d07014c9f8b4df02cdc4ad51c3",
      "text_ja_JP": "座って。木々も、あなたの見回りを無事に切り抜けたことだし。",
      "text_ja_JP_sha256": "102ba8987d7720d3d22426770402590943c20d57ca2a43f599ba7058a3cc3bb8",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_004",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/3",
      "text_en": "Then hold still. Even your armour is asking for a rest.",
      "text_en_sha256": "90281546c45b8461633e80bc93d4143728004df8e377fdcffdb3cf580acec74e",
      "text_ja_JP": "それなら、じっとしていて。鎧まで休みたがっているわ。",
      "text_ja_JP_sha256": "9df96f260cb159f45e033f24c670b0f67e71bf5a1aa2aa7241882f03df6bd12c",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_007",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/6",
      "text_en": "I know. You can also let me.",
      "text_en_sha256": "537604df026571501c729a95e200e3281662ac4e167677e4e7664d12c9ae6051",
      "text_ja_JP": "知っているわ。私に任せることだって、できるでしょう。",
      "text_ja_JP_sha256": "147c4027bf27923fba29dfa7d6b3fb179e422d4c2dec57cda60c42bdfb1becd8",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_010",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/9",
      "text_en": "You are supposed to answer that.",
      "text_en_sha256": "3195560810b3d5712865b971cac95653e5835eb71990632bb1b42ad00c86a4e6",
      "text_ja_JP": "それは、あなたが答えるところでしょう。",
      "text_ja_JP_sha256": "8e66629204ab37abdffb3c031f2b314dd960921cbd162b3cb0e96645cd8e0088",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_012",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/11",
      "text_en": "A wonderfully detailed report.",
      "text_en_sha256": "4fdfec21e8e430cc3112ff30a8d8684cd971f1bf1a38126c86237fc15507b7c0",
      "text_ja_JP": "なんて詳しい報告かしら。",
      "text_ja_JP_sha256": "908d14a4bc8347d3a9ddbc05d38f797b3237d72fcee93f3b580412befe6c9751",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_014",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/13",
      "text_en": "Careful. Another sentence and I might mistake that for a compliment.",
      "text_en_sha256": "04d2b34cbc1b19e8a404bd55033f93be0dedb3830ade1ef9d42acf0f5f7d7c8e",
      "text_ja_JP": "気をつけて。もう一言続けたら、褒め言葉だと勘違いしてしまいそう。",
      "text_ja_JP_sha256": "8e2f8da395f33634048f769a460b793f8416ecc45b9d67f3f6e4959025e5c9d6",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t2_after_017",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/1/after/lines/16",
      "text_en": "There. Your turn to be looked after.",
      "text_en_sha256": "fda3949066bf98929460adad390e77c80fcf1b0428636c48d9fbd31e2a7aaae1",
      "text_ja_JP": "ほら。今度は、あなたが気遣ってもらう番よ。",
      "text_ja_JP_sha256": "70dcf04b336ea9c60f665adf974850ca5fbd2fe0efebb725307e4456248d6a69",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_before_003",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/before/lines/2",
      "text_en": "You make it sound as though you ordered it specially.",
      "text_en_sha256": "f77be164867debcaaf637f531fbcb14efdb2f0f2ce650ad3d0c17d10fa434cad",
      "text_ja_JP": "わざわざ注文しておいたみたいな言い方ね。",
      "text_ja_JP_sha256": "b8bb2a5229370dc48f43ba9c9ce2b6395c4429dab4b2dd1f270604b30c54c652",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_before_005",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/before/lines/4",
      "text_en": "No view of the stars? A severe oversight.",
      "text_en_sha256": "a505ce2c0e6d7bc82efd4bae542bb2987fa824c827b1f73fb7e1d5b8188ea5b1",
      "text_ja_JP": "星の見えない屋根を？　それは重大な見落としね。",
      "text_ja_JP_sha256": "7e4df444f5ef04292e20e5da4def30ef266a86f0d7437dc196a5e4ff7b016cc2",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_before_009",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/before/lines/8",
      "text_en": "The previous tenants seem reluctant to leave.",
      "text_en_sha256": "6b7e2105c02590ccbe0e7dd8d8bf7ba7bcf05a2528b23f1904f4ccdcffc0777d",
      "text_ja_JP": "前の住人たちは、出ていく気がないようね。",
      "text_ja_JP_sha256": "0e536b8d0ba7ad5b24f90af5f592729a411208ff901159f22031dad12e3efd58",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_before_011",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/before/lines/10",
      "text_en": "You were very quick to decide we are a pair.",
      "text_en_sha256": "2dc53b378b9a25887771c7a3e4e03a06bfe62f8c3d02a0b451bf496a6b3dd10b",
      "text_ja_JP": "私たちが二人組だと決めるの、ずいぶん早かったのね。",
      "text_ja_JP_sha256": "afad3c479e5cf7d6c24bd7bf87a6be6b34ea42bd4c86d23931a1767c996c73c0",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_before_013",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/before/lines/12",
      "text_en": "Then keep your place. I intend to keep mine.",
      "text_en_sha256": "05be6983c9779e80ac2e99559e7a32275fd9c9139c58bbadb587f0b5f4420407",
      "text_ja_JP": "それなら、自分の場所を守って。私は、私の場所を守るつもりよ。",
      "text_ja_JP_sha256": "9bbc8d1dbd4b8aaf1d33a02d040594d7514498b60e861885da9d542fe32657ad",
      "emotion": "determined",
      "voice_track": null,
      "expression": "resolve",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_003",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/2",
      "text_en": "You have inspected the entire house in one breath.",
      "text_en_sha256": "35889106d05d0518b4e463629d1c38465d4af50f5f26763564936fcd0c246cb2",
      "text_ja_JP": "一息で、家じゅうを調べ終えたのね。",
      "text_ja_JP_sha256": "ab4dbcd3425cfed71499cb9339535ef75f833fe298dd2deccf3468bbf0e7a253",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_006",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/5",
      "text_en": "This seat appears to be available.",
      "text_en_sha256": "4a55a057b1da592a720f99482ed816c7dc377a16a545973404560cdf2ea5884e",
      "text_ja_JP": "こちらの席は、空いているようだけれど。",
      "text_ja_JP_sha256": "2c447e5a65290f6c51b7b50caf436ec34791a81cffaf639ac65793a6e7063c3e",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_008",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/7",
      "text_en": "You checked it on the way in.",
      "text_en_sha256": "84f037d96225cabb6b9e14053452dbf03097f3513d9fac9fefd7ec7701d8839b",
      "text_ja_JP": "入るときに、もう調べたでしょう。",
      "text_ja_JP_sha256": "305ba76e6b12826d38462a003b1e4d5912f7310b2f72c0aada11de11596edc00",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_010",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/9",
      "text_en": "An important distinction. Sit before you discover a third side.",
      "text_en_sha256": "d9bf614f2aab60f16fe59ac09270b98dd7dd3b6885964e79da6c536f3bcc8865",
      "text_ja_JP": "大切な違いね。三つ目の面を発見する前に、座って。",
      "text_ja_JP_sha256": "c9fecc65f53c16fe861270fed5ba6ec80ea25e77b454310cd7975b072d7bb8a5",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_013",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/12",
      "text_en": "Actual bread, or another of your possibilities?",
      "text_en_sha256": "26121970a838813510fd4eeb8399fa16bc98d0bfa5d64e412543fa2cf9288f72",
      "text_ja_JP": "ちゃんとしたパン？　それとも、また「あるかもしれない」という話？",
      "text_ja_JP_sha256": "e6bf82d80e807bc2c5c388110e2b18dceaee27576e1536cc315fad5c643b0fd0",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_015",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/14",
      "text_en": "A roof and a supper. You should announce your successes more often.",
      "text_en_sha256": "ffa9cb2348b1f10a523d625f07f115c5c671788fb6b500c3319bcfeb750ddaf8",
      "text_ja_JP": "屋根と夕食。もっと頻繁に、成果を発表するべきだわ。",
      "text_ja_JP_sha256": "01f7829b78b1b1e8a6e1970255631c60385de54a3fe5f48bff0d699947ac6a04",
      "emotion": "soft_smile",
      "voice_track": null,
      "expression": "warm",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_018",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/17",
      "text_en": "A flaw in the architecture of the loaf. Quite beyond my control.",
      "text_en_sha256": "5d0ecb2f052593c654f711ae113f19f04c65141036ddeed10080296b097df1ca",
      "text_ja_JP": "パンの構造上の欠陥ね。私の手には負えなかったわ。",
      "text_ja_JP_sha256": "d87474c3e74fc5e14e5aec75c91207bdd738a771a74d568d2e0d63bf85dac87f",
      "emotion": "dry_amusement",
      "voice_track": null,
      "expression": "wry",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_021",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/20",
      "text_en": "Tomorrow. Yes.",
      "text_en_sha256": "14c217fa43ac3e91b8fa3e6a21d7285f2be0b54630562cff0d4cf9ca06bf7624",
      "text_ja_JP": "明日。……ええ。",
      "text_ja_JP_sha256": "70dbc000da5c852f7c1a68081424c2c594ca6c5b1ad9ffe6bf1ace4c492fe392",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_023",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/22",
      "text_en": "Nothing that needs solving tonight.",
      "text_en_sha256": "61d916bfcc3ee3d69fbc8359a302175adbe5a37a04e9c0d48f18f3c596ddb15e",
      "text_ja_JP": "今夜、解決しなくてもいいことよ。",
      "text_ja_JP_sha256": "8c70f4f2a093b8f4128da9dbb42b0177f6353075a77fe755f1700cdd26328e5a",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
    {
      "line_id": "tutorial_t3_after_026",
      "speaker_id": "fadyme",
      "source": "game/data/entry/tutorial_v001.json",
      "source_pointer": "/chapters/2/after/lines/25",
      "text_en": "Stay a little while. Before you stand watch.",
      "text_en_sha256": "9e23b817a6491559d6eb52dc464926e5bc504ebfdcaaa70440a0dd58bc5ad77e",
      "text_ja_JP": "少しだけ、ここにいて。見張りに立つ前に。",
      "text_ja_JP_sha256": "8422cd1e5b84520eebb437485cb9c88f03f3d583a548cd6092edc4b5dd2a1daf",
      "emotion": "composed",
      "voice_track": null,
      "expression": "composed",
      "locale": "ja-JP",
      "provider_family": "Chirp3-HD",
      "voice_id": null,
      "text_status": "DRAFT_PENDING_NATIVE_JAPANESE_REVIEW",
      "translation_provenance": "Codex contextual Japanese adaptation 2026-10-09; no translation API",
      "recording_status": "NOT_GENERATED_NEW_TTS_RESET",
      "recording_path": null,
      "legacy_take_reuse": false,
      "delivery": "adult22, precise wry courtesy, pain restrained; no theatrical delivery"
    },
