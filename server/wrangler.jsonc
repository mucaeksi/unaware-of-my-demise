// Unaware of My Demise game API (DEC-0013). Deployed by .github/workflows/deploy.yml (DEC-0003); never commit secrets here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name (DEC-0001).
  "name": "unaware-of-my-demise",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Public API endpoint on workers.dev (OQ-013, owner 2026-10-04); a custom-domain route can replace it later.
  "workers_dev": true,
  // No public per-version preview URLs: only the deployed version answers.
  "preview_urls": false,
  "observability": { "enabled": true },
  // Data lifecycle job (INF-016, src/retention.ts): daily at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "hyperdrive": [
    // unaware-of-my-demise-production -> Neon UOMD (query caching off: transactional game state).
    { "binding": "HYPERDRIVE", "id": "edbe90afd0ab42a1ab708e7e2e49c04b" }
  ],
  // Private content-patch bucket (INF-029, DEC-0030): read only by this Worker, never public.
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "unaware-of-my-demise-content" }],
  // LEGACY server/ratelimit.py budgets: sign-in 20/min, everything else 240/min, per client IP.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } }
  ],
  "vars": {
    // Comma-separated Google OAuth client IDs accepted as the ID token audience. Empty = sign-in answers 503.
    "GOOGLE_CLIENT_IDS": "",
    // Banner rotation launch instant (ISO-8601 Monday 00:00 UTC). Empty = undated: the first banner pair stays open.
    "BANNER_EPOCH": "",
    // The git commit of this deployment; the deploy workflow sets it with --var. Empty = not recorded.
    "RELEASE_SOURCE_SHA": "",
    // The lowest Android versionCode the API serves; older apps get 426 UPDATE_REQUIRED (GET /v1/bootstrap reports it).
    "MIN_CLIENT_VERSION_CODE": "1",
    // Non-empty = maintenance: every game route answers 503 MAINTENANCE with this message. Changing it is a redeploy.
    "MAINTENANCE_MESSAGE": "",
    // The content channel this Worker serves from the bucket (channels/<channel>/current.json).
    "CONTENT_CHANNEL": "production"
  },
  // Staging (INF-006, DEC-0025): Worker "unaware-of-my-demise-staging" on its own Hyperdrive config and Neon branch, with
  // its own rate-limit counters. Deployed only by .github/workflows/deploy-staging.yml (`wrangler deploy --env staging`).
  // Bindings and vars are not inherited by an environment, so each one is repeated here. The all-zero Hyperdrive id is a
  // placeholder: until the staging Hyperdrive exists (owner decision D-07), the staging workflow skips.
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["17 3 * * *"] },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      // Same private bucket, its own channel prefix (channels/staging/): staging never moves the production pointer.
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "unaware-of-my-demise-content" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 240, "period": 60 } }
      ],
      "vars": {
        "GOOGLE_CLIENT_IDS": "",
        "BANNER_EPOCH": "",
        "RELEASE_SOURCE_SHA": "",
        "MIN_CLIENT_VERSION_CODE": "1",
        "MAINTENANCE_MESSAGE": "",
        "CONTENT_CHANNEL": "staging"
      }
    }
  }
}
