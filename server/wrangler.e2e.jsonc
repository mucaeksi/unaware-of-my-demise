// End-to-end tests only (INF-042): `wrangler dev --config wrangler.e2e.jsonc` with a local database
// (CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE). Never deployed: deploy.yml uses wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unaware-of-my-demise-e2e",
  "main": "src/e2e-index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgresql://placeholder@localhost/placeholder" }],
  "vars": {
    "GOOGLE_CLIENT_IDS": "",
    "BANNER_EPOCH": "",
    "RELEASE_SOURCE_SHA": "",
    "MIN_CLIENT_VERSION_CODE": "1",
    "MAINTENANCE_MESSAGE": "",
    "CONTENT_CHANNEL": "test"
  }
}
