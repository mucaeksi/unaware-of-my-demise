    {
      "file": "character_stories_part1.json",
      "line_id": "cs_brin_alder_2_002",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Companion_Stories/character_stories_part1.json",
      "previous_text_en": "I can recut it. I brought a chisel.",
      "text_en": "I can recut it. I keep a chisel for the register board."
    },
    {
      "file": "character_stories_part1.json",
      "line_id": "cs_brin_alder_2_004",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Companion_Stories/character_stories_part1.json",
      "previous_text_en": "Then say his name while I cut. Then they are yours.",
      "text_en": "Then say his name while I cut. Then the letters are yours."
    },
    {
      "file": "character_stories_part1.json",
      "line_id": "cs_brin_alder_3_002",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Companion_Stories/character_stories_part1.json",
      "previous_text_en": "You said this sentence at a shrine once. Mahmut told me.",
      "text_en": "You said that at the shrine. Word for word. I was there."
    },
    {
      "file": "character_stories_part1.json",
      "line_id": "cs_brin_alder_3_006",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Companion_Stories/character_stories_part1.json",
      "previous_text_en": "That is how a road is made.",
