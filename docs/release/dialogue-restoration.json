{
  "baseline_commit": "3d05c7682e8a44d3f65b9b978c9f1c1c1fc43c0bf4",
  "source_role": "Preserved canonical main-story source; runtime presentation fields retained.",
  "changes": [
    {
      "file": "story_script_ch03.json",
      "scene_id": "vn_3_1",
      "field": "post_battle_lines",
      "line_id": "node_3_1_post_004",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch03.json",
      "text_en": "Every year I hid, someone else paid my hours."
    },
    {
      "file": "story_script_ch03.json",
      "line_id": "node_3_5_post_001",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch03.json",
      "previous_text_en": "Seven notches. Same wax as the cathedral. There are letters beneath it: C.V.",
      "text_en": "Seven notches. Same wax as the seal on your shield. There are letters beneath it: C.V."
    },
    {
      "file": "story_script_ch04.json",
      "scene_id": "vn_4_5",
      "field": "post_battle_lines",
      "line_id": "node_4_5_post_007",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch04.json",
      "text_en": "I will hang the lantern first. People should see the door before they need it."
    },
    {
      "file": "story_script_ch04.json",
      "scene_id": "ch4_road",
      "field": "lines",
      "line_id": "ch4_road_006",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch04.json",
      "text_en": "Gray wax on Guild scouts, and the scouts still breathing. Someone is hunting my Guild's hunters."
    },
    {
      "file": "story_script_ch04.json",
      "line_id": "ch4_camp_006",
      "action": "canon_text_restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch04.json",
      "previous_text_en": "East, then. The estate schedule is somewhere past the ravine.",
      "text_en": "East, then. The altar road crosses the ravine."
    },
    {
      "file": "story_script_ch05.json",
      "scene_id": "vn_5_5",
      "field": "post_battle_lines",
      "line_id": "node_5_5_post_005",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch05.json",
      "text_en": "My kiln company is guarding the refugee road. They need someone loud. I am extremely loud!"
    },
    {
      "file": "story_script_ch06.json",
      "scene_id": "vn_6_1",
      "field": "post_battle_lines",
      "line_id": "node_6_1_post_004",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch06.json",
      "text_en": "There is a row of graves behind this wing. No names. I am coming back for them."
    },
    {
      "file": "story_script_ch06.json",
      "scene_id": "vn_6_3",
      "field": "post_battle_lines",
      "line_id": "node_6_3_post_004",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch06.json",
      "text_en": "Th-then we plant something in it. Absences hate that."
    },
    {
      "file": "story_script_ch06.json",
      "scene_id": "ch6_road",
      "field": "lines",
      "line_id": "ch6_road_005",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch06.json",
      "text_en": "Gray wax on the milestone, still soft. She passed here this morning. She is ahead of us."
    },
    {
      "file": "story_script_ch06.json",
      "scene_id": "ch6_road",
      "field": "lines",
      "line_id": "ch6_road_006",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch06.json",
      "text_en": "Then she reaches the altar before we do."
    },
    {
      "file": "story_script_ch07.json",
      "scene_id": "vn_7_3",
      "field": "pre_battle_lines",
      "line_id": "node_7_3_pre_007",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch07.json",
      "text_en": "I came here to be offered. They are asking me to be witnessed."
    },
    {
      "file": "story_script_ch07.json",
      "scene_id": "vn_7_3",
      "field": "pre_battle_lines",
      "line_id": "node_7_3_pre_008",
      "action": "restored",
      "source": "narrative/09_VN_Scripts/Main_Story/story_script_ch07.json",
      "text_en": "I will sing it while you write. The page will not dare lose its place."
    },
    {
