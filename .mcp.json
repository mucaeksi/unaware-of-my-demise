{
  "mcpServers": {
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--offline",
        "--no-project",
        "--with",
        "graphifyy[mcp]==0.9.84",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    },
    "chrome-devtools": {
      "command": "node",
      "args": [
        "tools/mcp_chrome_devtools.mjs"
      ]
    },
    "uomd-unity-live": {
      "command": "node",
      "args": [
        "node_modules/tsx/dist/cli.mjs",
        "tools/mcp_unity_live.ts"
      ]
    },
    "unityMCP": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpforunityserver==10.3.0",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ]
    }
  }
}
