{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "tools/mcp_chrome_devtools.mjs"
      ]
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "graphifyy[mcp]==0.9.84",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    },
    "uomd-pixi-live": {
      "command": "node",
      "args": [
        "node_modules/tsx/dist/cli.mjs",
        "tools/mcp_pixi_live.ts"
      ]
    }
  }
}
