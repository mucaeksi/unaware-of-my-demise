{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "command": "bash",
      "args": [
        "tools/mcp_chrome_devtools.sh"
      ]
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "graphifyy[mcp]==0.9.84",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    }
  }
}
