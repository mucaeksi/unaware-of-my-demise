# Runtime/deployment template only.
# Primary production deployment is cloud-based.

# Backend (if/when the current starter API is run outside Workers)
PORT=8080
DATABASE_URL=CHANGE_ME
JWT_SECRET=CHANGE_ME

# Patch/content delivery
PATCH_BASE_URL=https://example.invalid/patches

# NOTE:
# GEMINI_API_KEY is NOT a production game secret in this architecture.
# Gemini is used only by Claude Code for development-time creative asset generation.
# Configure it in the Claude Code Cloud Environment API Credentials section.
