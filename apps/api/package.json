{
  "name": "@uomd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:game": "wrangler dev -c wrangler.game.jsonc --env dev --port 8787",
    "dev:admin": "wrangler dev -c wrangler.admin.jsonc --env dev --port 8788",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "db:migrate:dev": "wrangler d1 migrations apply DB -c wrangler.game.jsonc --env dev --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB -c wrangler.game.jsonc --env staging --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB -c wrangler.game.jsonc --env dev --local"
  },
  "dependencies": {
    "@uomd/combat": "*",
    "@uomd/content-schema": "*",
    "@uomd/economy": "*",
    "@uomd/patch": "*",
    "@uomd/shared": "*",
    "age-encryption": "^0.3.1",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "wrangler": "4.149.0"
  }
}
