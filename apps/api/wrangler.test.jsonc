{
  // Used only by vitest (Miniflare, fully local). Real databases are never touched by tests.
  "name": "uomd-test",
  "main": "src/game.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{ "binding": "DB", "database_name": "test", "database_id": "00000000-0000-0000-0000-000000000000" }, { "binding": "MIGRATION_DB", "database_name": "migration-test", "database_id": "00000000-0000-0000-0000-000000000001" }, { "binding": "MIGRATION_EMPTY_DB", "database_name": "migration-empty-test", "database_id": "00000000-0000-0000-0000-000000000002" }],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "test-content" }],
  "vars": { "ENVIRONMENT": "dev", "CONTENT_CHANNEL": "dev" }
}
