{
  // Public game Worker: serves the Phaser client (static assets) and /api/v1/*.
  // There is deliberately NO top-level/production deployment here; production needs the owner's approval.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uomd-game",
  "main": "src/game.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "0c942d198668a8b1a8e8ee699651b817",
  "workers_dev": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    "dev": {
      "name": "uomd-game-dev",
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "dev", "CONTENT_CHANNEL": "dev", "ADMOB_APP_ID": "ca-app-pub-4258559369390965~2559970251", "ADMOB_AD_UNIT_IDS": "ca-app-pub-4258559369390965/3553164322" },
      "assets": { "directory": "../game/dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "uomd-dev", "database_id": "0512d420-db4b-4851-8971-71c138f713cb", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "uomd-content-dev" }],
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "2101", "simple": { "limit": 120, "period": 60 } }]
    },
    "staging": {
      "name": "uomd-game-staging",
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "CONTENT_CHANNEL": "staging",
        "ADMOB_APP_ID": "ca-app-pub-4258559369390965~2559970251",
        "ADMOB_AD_UNIT_IDS": "ca-app-pub-4258559369390965/3553164322",
        // public identifiers (not secrets): OAuth Web client = Google ID token audience; Play package; Pub/Sub push identity for RTDN
        "GOOGLE_CLIENT_IDS": "604013824221-n7htgfhfs55njs5ie11ulojsk1tnk6da.apps.googleusercontent.com",
        "PLAY_PACKAGE_NAME": "io.github.mucaeksi.unawareofmydemise",
        "RTDN_PUSH_SERVICE_ACCOUNT": "uomd-play-billing@unaware-of-my-demise.iam.gserviceaccount.com",
        "RTDN_AUDIENCE": "https://uomd-game-staging.muratcaneksiii.workers.dev/api/v1/billing/rtdn"
      },
      "assets": { "directory": "../game/dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "uomd-staging", "database_id": "687f9735-ee4c-4611-aa16-2fae99e51911", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "uomd-content-staging" }],
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } }]
    }
  }
}
