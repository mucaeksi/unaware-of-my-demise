<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors Assets/_UOMD/Scripts/Combat/Uomd.Combat.asmdef (references: Uomd.Core). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Uomd.Combat</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UomdScripts)Combat/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false + DisableTransitiveProjectReferences keeps the asmdef boundary: Combat sees Core only. -->
    <ProjectReference Include="../Uomd.Core/Uomd.Core.csproj" />
  </ItemGroup>
</Project>
