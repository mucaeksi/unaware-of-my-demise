      "line_id": "ch4_camp_005",
      "speaker": "fadyme_thought",
      "speaker_display": "Fadyme (thought)",
      "text": "Weeks. I will spend some of them standing in the sun. That much I can choose.",
      "emotion": "bittersweet",
      "voice_track": "jp_inner"
    },
    {
      "op": "say",
      "line_id": "ch4_camp_006",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "East, then. The altar road crosses the ravine.",
