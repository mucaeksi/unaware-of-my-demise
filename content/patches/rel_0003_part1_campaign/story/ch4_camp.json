      "op": "say",
      "line_id": "ch4_camp_002",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "The sun is warm. I had forgotten it was allowed to be.",
      "emotion": "soft",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch4_camp_003",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "The elixir. Did Kera say when?",
      "emotion": "hopeful",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch4_camp_004",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "Soon. She is very good at soon.",
      "emotion": "steady",
      "voice_track": "jp"
    },
    {
