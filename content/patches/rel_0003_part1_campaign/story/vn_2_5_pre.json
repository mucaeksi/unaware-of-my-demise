      "speaker": "lady_yseldra_vale",
      "speaker_display": "Yseldra",
      "text": "You found the record. You still do not know what it asks of her.",
      "emotion": "controlled",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_002",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "Then tell us.",
      "emotion": "angry",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_003",
      "speaker": "lady_yseldra_vale",
      "speaker_display": "Yseldra",
      "text": "The altar does not cure. It keeps a wound open until the kingdom can be put back inside it.",
      "emotion": "grave",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_004",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "You came to take me away.",
      "emotion": "quiet",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_005",
      "speaker": "lady_yseldra_vale",
      "speaker_display": "Yseldra",
      "text": "I came to stop the next sacrifice. I will not pretend that makes my choice yours.",
      "emotion": "honest",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_006",
      "speaker": "lady_yseldra_vale",
      "speaker_display": "Yseldra",
      "text": "And you, Sir Mahmut. You told her you did not know me.",
      "emotion": "cold",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_007",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "Mahmut?",
      "emotion": "stunned",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "node_2_5_pre_008",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "Not now.",
      "emotion": "tight",
      "voice_track": "jp"
