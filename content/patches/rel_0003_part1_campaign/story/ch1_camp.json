      "op": "say",
      "line_id": "ch1_camp_001",
      "speaker": "brin_alder",
      "speaker_display": "Brin",
      "text": "The trees stopped whispering.",
      "emotion": "quiet",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_002",
      "speaker": "nixie_vale",
      "speaker_display": "Nixie",
      "text": "No. Listen. They are whispering someone else's name now.",
      "emotion": "alert",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_003",
      "speaker": "narrator",
      "speaker_display": "Narration",
      "text": "Beyond the firelight, a single cracked bell rang, then went still.",
      "emotion": "tense",
      "voice_track": "jp_narration"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_004",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "Her.",
      "emotion": "hard",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_005",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "She is not coming closer. She wants us to know she is there.",
      "emotion": "steady",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_006",
      "speaker": "fadyme_thought",
      "speaker_display": "Fadyme (thought)",
      "text": "The widow's bell. It rang like that the night Mother's portrait came down.",
      "emotion": "shaken",
      "voice_track": "jp_inner"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_007",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "Sleep. I will watch.",
      "emotion": "protective",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch1_camp_008",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "You always say that. One day I will watch, and you will sleep.",
      "emotion": "light",
      "voice_track": "jp"
    },
