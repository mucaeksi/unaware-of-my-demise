      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "A signal.",
      "emotion": "alert",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch6_road_002",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "Sable. She said she would open a door from inside.",
      "emotion": "relieved",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch6_road_003",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "You trust her.",
      "emotion": "searching",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch6_road_004",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "She opens doors for others and never walks through first. People like that keep their word.",
      "emotion": "perceptive",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch6_road_005",
      "speaker": "fadyme",
      "speaker_display": "Fadyme",
      "text": "Gray wax on the milestone, still soft. She passed here this morning. She is ahead of us.",
      "emotion": "uneasy",
      "voice_track": "jp"
    },
    {
      "op": "say",
      "line_id": "ch6_road_006",
      "speaker": "mahmut",
      "speaker_display": "Mahmut",
      "text": "Then she reaches the altar before we do.",
      "emotion": "grim",
      "voice_track": "jp"
    },
