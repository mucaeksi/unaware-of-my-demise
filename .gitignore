# CCGS hook runtime output (regenerated every turn; durable state lives in
# production/session-state/active.md). Keep the directory placeholder.
production/session-logs/*
!production/session-logs/README.md

# UomdNative AARs: built from game/android/plugins/uomd_native by game/tools/build_uomd_native.sh
game/addons/uomd_native/bin/
game/android/plugins/uomd_native/.gradle/
# Generated by build_uomd_native.sh from ADMOB_APP_ID.
game/android/plugins/uomd_native/src/main/res/values/uomd_admob.xml
# Godot Android build template (installed from the export templates by game/tools/build_android_debug.sh)
game/android/build/
game/android/.build_version
__pycache__/
*.pyc
server/.wrangler/

# Graphify çıktı dosyalarını Codex ve Git indeksinden hariç tut
graphify-out/
.graphify_analysis.json

# Local mixed-license GDQuest demo; restore from the pinned installer.
references/gdquest_vfx/upstream/
references/free_2d/upstream/

# Local Codex skill-discovery link; bootstrap after clone/move.
/.agents/skills/
