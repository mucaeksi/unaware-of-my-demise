{
  "name": "uomd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unaware of My Demise - monorepo (Phaser 4 game, Cloudflare Worker API, React Control Center)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "build:content": "node tools/build_content.mjs",
    "build": "npm run build:content && npm run build -w @uomd/game && npm run build -w @uomd/admin",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.1",
    "eslint": "10.12.0",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
